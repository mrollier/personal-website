---
// The stochastic CA of Eq. (3.2) as eight probabilities, one per neighbourhood, and its continuous twin of Section 4.2.
// Mix two elementary rules with a coin to fill them in (Eq. 3.1), or set them by hand. Three pictures from the same
// start: one run, the average of 200 runs (grey is the share of runs in which the cell is 1), and the continuous CA that
// treats neighbouring cells as independent. Self-contained with src/scripts/taxonomy.ts, wolfram.ts, net.ts, raster.ts,
// palette.ts and figure.ts. The URL query under `mix.` keeps the settings.
const PRESETS = [
  { name: 'rule 22, half the time', phi: 22, psi: 204, p: 0.5, init: 'seed' },
  { name: 'the majority SCA', phi: 232, psi: 51, p: 0.9, init: 'random' },
  { name: 'rules 90 and 150', phi: 90, psi: 150, p: 0.5, init: 'seed' },
  { name: 'pure noise', phi: 0, psi: 255, p: 0.5, init: 'random' },
  { name: 'rule 110, always', phi: 110, psi: 110, p: 1, init: 'random' },
];
const NBH = [7, 6, 5, 4, 3, 2, 1, 0];
---
<figure class="fig" id="mix" data-mixture data-presets={JSON.stringify(PRESETS)} tabindex="-1">
  <canvas role="img" aria-label="One run, the average of many runs, and the continuous cellular automaton"></canvas>
  <div class="controls" role="group" aria-label="Mix two rules">
    <label>mix <select name="preset">{PRESETS.map((q) => <option value={q.name}>{q.name}</option>)}<option value="">by hand</option></select></label>
    <label>φ <input name="phi" type="number" min="0" max="255" value="22" inputmode="numeric" /></label>
    <label>ψ <input name="psi" type="number" min="0" max="255" value="204" inputmode="numeric" /></label>
    <label>chance of φ <input name="p" type="range" min="0" max="1" step="0.05" value="0.5" /> <output name="pv">0.50</output></label>
  </div>
  <div class="probs" role="group" aria-label="Chance of a 1 after each neighbourhood">
    {NBH.map((n) => (
      <label>
        <span class="nbh" aria-hidden="true">{[4, 2, 1].map((bit) => <i class={n & bit ? 'on' : ''} />)}</span>
        <span class="sr">{`${(n >> 2) & 1}${(n >> 1) & 1}${n & 1}`}</span>
        <input type="range" min="0" max="1" step="0.05" data-n={n} aria-label={`chance of a 1 after ${(n >> 2) & 1}${(n >> 1) & 1}${n & 1}`} />
        <output data-v={n}></output>
      </label>
    ))}
  </div>
  <div class="controls" role="group" aria-label="Start">
    <span class="seg" role="group" aria-label="Start from">start from
      <button type="button" data-init="seed" aria-pressed="true">one cell</button>
      <button type="button" data-init="random" aria-pressed="false">random cells</button>
    </span>
    <button name="again" type="button">new coins</button>
  </div>
  <output name="status" class="status" aria-live="polite"></output>
</figure>

<style>
  .fig { margin: 1.5rem 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .fig:focus { outline: none; }
  canvas { display: block; width: 100%; height: 320px; background: var(--panel); border: 1px solid var(--line); }
  .controls, .status, .probs { font-family: var(--mono); font-size: 0.85rem; color: var(--muted); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; }
  .controls label { display: inline-flex; align-items: center; gap: 0.35rem; }
  .controls button, .controls select {
    font: inherit; color: var(--ink); background: none; border: 1px solid var(--line);
    padding: 0.1em 0.6em; cursor: pointer; touch-action: manipulation;
  }
  .controls button:hover, .controls select:hover { border-color: var(--accent); }
  .seg { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; }
  .seg button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .controls input[type="number"] { font: inherit; width: 4.5em; color: var(--ink); background: var(--bg); border: 1px solid var(--line); padding: 0.1em 0.3em; }
  input[type="range"] { width: 7rem; accent-color: var(--accent); margin: 0; }
  /* the eight neighbourhoods as in a rule table, each with its chance of a 1 */
  .probs { display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: 0.3rem 1rem; }
  .probs label { display: flex; align-items: center; gap: 0.4rem; }
  .probs input { flex: 1; min-width: 4rem; }
  .probs output { width: 2.6em; text-align: right; color: var(--ink); }
  .nbh { display: inline-flex; }
  .nbh i { width: 0.8em; height: 0.8em; border: 1px solid var(--ink); margin-right: -1px; background: var(--bg); }
  .nbh i.on { background: var(--ink); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .status { display: block; min-height: 1.4em; color: var(--ink); }
</style>

<script>
  import { tableOf } from '../scripts/wolfram';
  import { makeRng } from '../scripts/net';
  import { mixture, octStep, ccaStep } from '../scripts/taxonomy';
  import { Raster } from '../scripts/raster';
  import { parse, mix } from '../scripts/palette';
  import { fit, tokens, watch, urlState, keys, label, schedule } from '../scripts/figure';

  const N = 81, T = 60, RUNS = 200;

  function mount(el: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(n: string) => el.querySelector<T>(`[name="${n}"]`)!;
    const c = el.querySelector('canvas')!, ctx = c.getContext('2d')!, status = $<HTMLOutputElement>('status');
    const presetIn = $<HTMLSelectElement>('preset'), phiIn = $<HTMLInputElement>('phi'), psiIn = $<HTMLInputElement>('psi'), pIn = $<HTMLInputElement>('p'), pv = $<HTMLOutputElement>('pv');
    const sliders = Array.from(el.querySelectorAll<HTMLInputElement>('[data-n]')), outs = Array.from(el.querySelectorAll<HTMLOutputElement>('[data-v]'));
    const initBtns = Array.from(el.querySelectorAll<HTMLButtonElement>('[data-init]'));
    const PRESETS = JSON.parse(el.dataset.presets!) as { name: string; phi: number; psi: number; p: number; init: string }[];
    const url = urlState('mix', { phi: '22', psi: '204', p: '0.5', prob: '', init: 'seed', seed: '1' });
    const byte = (v: string, def: number) => { const x = Math.round(+v); return Number.isFinite(x) && x >= 0 && x <= 255 ? x : def; };
    let phi = byte(url.get('phi'), 22), psi = byte(url.get('psi'), 204), p = Math.min(1, Math.max(0, +url.get('p'))), init = url.get('init') === 'random' ? 'random' : 'seed', seed = Math.max(1, Math.round(+url.get('seed')) || 1);
    if (!Number.isFinite(p)) p = 0.5;
    const fromUrl = url.get('prob').split(',').map(Number);
    let prob = fromUrl.length === 8 && fromUrl.every((v) => v >= 0 && v <= 1) ? Float64Array.from(fromUrl) : mixture(tableOf(phi), tableOf(psi), p), byHand = fromUrl.length === 8;
    let one: Uint8Array[] = [], mean: Float64Array[] = [], cca: Float64Array[] = [], rasters: Raster[] = [], text = '';

    function build() {
      const rnd = makeRng(seed * 7919 + 5), start = new Uint8Array(N);
      if (init === 'seed') start[N >> 1] = 1; else for (let i = 0; i < N; i++) start[i] = rnd() < 0.5 ? 1 : 0;
      mean = Array.from({ length: T + 1 }, () => new Float64Array(N));
      for (let r = 0; r < RUNS; r++) {
        let row = start;
        for (let t = 0; t <= T; t++) { if (r === 0) one[t] = row; const m = mean[t]; for (let i = 0; i < N; i++) m[i] += row[i] / RUNS; if (t < T) row = octStep(row, prob, rnd); }
      }
      cca = [Float64Array.from(start)];
      for (let t = 0; t < T; t++) cca.push(ccaStep(cca[t], prob));
      const gap = (t: number) => mean[t].reduce((a, v, i) => a + Math.abs(v - cca[t][i]), 0) / N;
      const pct = (row: ArrayLike<number>) => { let s = 0; for (let i = 0; i < N; i++) s += row[i]; return `${Math.round((100 * s) / N)}%`; };
      text = prob.every((v) => v === 0 || v === 1)
        ? `Every chance is 0 or 1, so this is an ordinary rule: all ${RUNS} runs are the same, and so is the continuous CA.`
        : `For one tick the continuous CA gives each cell's chance exactly (the average of ${RUNS} runs is off by ${gap(1).toFixed(3)} per cell: sampling noise). After that it treats neighbouring cells as independent, which they no longer are: after ${T} ticks the two are ${gap(T).toFixed(2)} apart per cell, with ${pct(mean[T])} of cells 1 on average against ${pct(cca[T])} predicted.`;
      rasters = [0, 1, 2].map(() => new Raster(N, T + 1));
    }

    function paint() {
      const w = c.getBoundingClientRect().width; if (w < 1) return;
      const gap = 14, cap = 18, row = w >= 560, pw = row ? (w - 16 - 2 * gap) / 3 : Math.min(w - 16, 480), ph = (pw / N) * (T + 1);
      const want = `${Math.ceil(row ? cap + ph + 16 : 3 * (cap + ph) + 2 * gap + 16)}px`;
      if (c.style.height !== want) c.style.height = want;
      const sz = fit(c); if (!sz) return;
      const t = tokens(c), ink = parse(t.ink), pan = parse(t.panel);
      ctx.fillStyle = t.panel; ctx.fillRect(0, 0, sz.w, sz.h);
      const names = ['one run', `average of ${RUNS} runs`, 'continuous CA'];
      [one, mean, cca].forEach((rows, k) => {
        const r = rasters[k], x = row ? 8 + k * (pw + gap) : (sz.w - pw) / 2, y = row ? 8 + cap : 8 + cap + k * (cap + ph + gap);
        for (let j = 0; j <= T; j++) for (let i = 0; i < N; i++) r.set(j * N + i, mix(pan, ink, rows[j][i]));
        r.flush(); r.blit(ctx, { x, y, w: pw, h: ph });
        ctx.strokeStyle = t.line; ctx.lineWidth = 1; ctx.strokeRect(x - 0.5, y - 0.5, pw + 1, ph + 1);
        label(ctx, names[k], x, y - 5, t, { color: t.ink, size: 11 });
      });
      status.value = text;
      c.setAttribute('aria-label', text);
    }

    function show() {
      const pre = PRESETS.find((q) => q.phi === phi && q.psi === psi && q.p === p);
      presetIn.value = !byHand && pre ? pre.name : '';
      phiIn.value = String(phi); psiIn.value = String(psi); pIn.value = String(p); pv.value = p.toFixed(2);
      sliders.forEach((s, k) => { const n = +s.dataset.n!; s.value = String(prob[n]); outs[k].value = prob[n].toFixed(2); });
      for (const b of initBtns) b.setAttribute('aria-pressed', String(b.dataset.init === init));
    }
    const later = schedule(() => { build(); paint(); });
    const redo = () => {
      show(); later();
      url.set('phi', String(phi)); url.set('psi', String(psi)); url.set('p', String(p)); url.set('prob', byHand ? Array.from(prob, (v) => +v.toFixed(2)).join(',') : '');
      url.set('init', init); url.set('seed', String(seed));
    };
    const remix = () => { byHand = false; prob = mixture(tableOf(phi), tableOf(psi), p); redo(); };
    presetIn.addEventListener('change', () => { const q = PRESETS.find((x) => x.name === presetIn.value); if (!q) return; phi = q.phi; psi = q.psi; p = q.p; init = q.init; remix(); });
    phiIn.addEventListener('change', () => { phi = byte(phiIn.value, phi); remix(); });
    psiIn.addEventListener('change', () => { psi = byte(psiIn.value, psi); remix(); });
    pIn.addEventListener('input', () => { p = +pIn.value; remix(); });
    for (const s of sliders) s.addEventListener('input', () => { byHand = true; prob[+s.dataset.n!] = +s.value; redo(); });
    for (const b of initBtns) b.addEventListener('click', () => { init = b.dataset.init!; redo(); });
    const again = () => { seed++; redo(); };
    $('again').addEventListener('click', again);
    keys(el, { n: again });
    show(); build();
    watch(c, paint);
  }

  document.querySelectorAll<HTMLElement>('[data-mixture]').forEach(mount);
</script>

---
// What the deck shows around the slide while presenting: the counter, the rehearsal clock, the way out, the black
// screen of the clicker's blank button, and the pictograms the slides draw people with.
type Props = { exit?: boolean };
const { exit = true } = Astro.props;
---
<div class="hud">
  <output data-clock hidden></output>
  <output data-counter></output>
  {exit && <button type="button" data-exit aria-label="leave the presentation" title="leave (q)">&times;</button>}
</div>
<div class="blank" data-blank hidden></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <!-- a person with the hand up, and one with the arm down; 100 × 130 -->
    <symbol id="hand-up" viewBox="0 0 100 130">
      <circle cx="44" cy="30" r="15" />
      <path d="M20 128 V86 Q20 60 44 60 Q68 60 68 86 V128 Z" />
      <path d="M64 76 L84 20" stroke-width="12" stroke-linecap="round" fill="none" />
      <circle cx="86" cy="14" r="9" />
    </symbol>
    <symbol id="hand-down" viewBox="0 0 100 130">
      <circle cx="44" cy="30" r="15" stroke-width="3" />
      <path d="M20 128 V86 Q20 60 44 60 Q68 60 68 86 V128 Z" stroke-width="3" />
      <path d="M71 78 L76 122" stroke-width="3" fill="none" stroke-linecap="round" />
    </symbol>
  </defs>
</svg>

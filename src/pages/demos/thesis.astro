const answers: { id: string; name: string; answer: string; limit: string; next: string }[] = [
  { id: 'defects', name: 'Defects', answer: 'Only affine rules admit an exact linear description of how a defect spreads. For them the Lyapunov spectrum follows without simulation: from the Fourier transform of the rule’s stencil on a lattice, and from the spectrum of the adjacency matrix for the parity rule on a network.', limit: 'The spectrum measures the growth of walk counts, not of Boolean damage; beyond the affine case the two are only loosely related.', next: 'A result that connects walk counts to Boolean damage; directed and weighted networks.' },
  { id: 'two-numbers', name: 'Two numbers', answer: 'Complementation symmetry requires the mirrored, odd-resolution cut of the density axis. The Hamming weight predicts the final density and the Boolean sensitivity the final defect density at the mean-field level (R ≈ 0.7 and 0.55), up to deviations the network causes and the rule alone cannot see.', limit: 'One-step annealed approximations, tested at one resolution, on one network family, at one starting density.', next: 'Other resolutions and hub-heavy networks; transient lengths as a dynamical rather than an asymptotic test.' },
  { id: 'synchronisation', name: 'Synchronisation', answer: 'Two analytical conditions reduce the resolution-9 rule space by four orders of magnitude, to 27 candidates; one of them synchronises most rewired rings and grids but fails at low degree and on the unrewired ring. A symmetry turns the same conditions into consensus conditions and yields a consensus-seeking rule for every network class except the sparsest.', limit: 'The filter was never compared with an unfiltered sample; every success rate is a point estimate; the conditions were tuned to degree 8.', next: 'Exhaustive checks at lower resolutions; sweeps over network size and horizon; empirical networks.' },
  { id: 'cnn', name: 'CA as CNN', answer: 'Exact simulation is possible without a single learned parameter, for non-uniform automata in a CNN and for Life-like network automata in a GNN. The embedding beats only a pure-Python baseline; against vectorised sparse matrices the GNN is two to four times slower on a CPU.', limit: 'The speed verdict depends on the baseline, and the CNN emulator was not compared with a vectorised one at all.', next: 'A design for the GPU, which is also where faster impact analysis would come from.' },
  { id: 'cheating', name: 'Cheating CNN', answer: 'Without precautions the network identifies the rule, because a spacetime diagram contains the rule table. Trimming and augmentation cut rule recovery from over 99 to 61 percent while class accuracy stays at 98: a shift, not a decoupling.', limit: 'No rule was held out, so generalisation across rules was never tested; the two accuracies come from separately trained networks.', next: 'Hold out whole equivalence classes of rules; label-free representations for automata beyond the elementary ones.' },
  { id: 'jaggedness', name: 'Jaggedness', answer: 'Jaggedness, a network-free simplification of the neighbourhood sensitivity, correlates with classification accuracy on 13 of 23 datasets and supports a search that gets close to the exhaustive optimum at a fraction of its cost. Where it fails, no other rule property succeeds either.', limit: 'Small evaluation sets and optimistic best-rule accuracies; resolutions up to 6 only; no comparison with other classifiers.', next: 'The symmetric formulation; a sampled search at resolution 9; a head-to-head with graph kernels and GNNs.' },
  { id: 'impact', name: 'Impact', answer: 'A few targeted swaps redirect the consensus where random swaps only randomise it, and clamping yields a dynamical importance score that needs no structural computation. The score correlates with centrality but reduces to no single measure.', limit: 'The score is a property of the node under one probe, mixes two kinds of clamping, and its reliability across starts was not checked.', next: 'An independent dynamical probe on the same networks; faster simulation, to try rules, horizons and networks exhaustively.' },
];
import { getCollection } from 'astro:content';
const pubs = await getCollection('publications');

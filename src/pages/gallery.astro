---
import Base from '../layouts/Base.astro';
// Images are the fronts rendered with 4 pixels per cell and the bleed trimmed, lossless; the PDFs are the print files (postcards: the front only).
type Piece = { id: string; title: string; text: string; size: string; cells: string; w: number; h: number; pdf: string; kb: number };
const postcards: Piece[] = [
  { id: 'conway', title: 'John Conway', text: 'Level-3 tiles on an automaton in UGent yellow and blue, the recipe of the mosaic in the project README.', size: 'A6', cells: '528 × 732 cells of 0.21 mm', w: 1984, h: 2797, pdf: 'postcard-conway.pdf', kb: 571 },
  { id: 'paraty', title: 'Paraty Mirim', text: 'The coast from my thesis cover, with tiles in the sea.', size: 'A6', cells: '264 × 366 cells of 0.42 mm', w: 993, h: 1400, pdf: 'postcard-paraty.pdf', kb: 201 },
  { id: 'liquid-vortex', title: 'Liquid light: vortex', text: 'Stained glass: the whole card packed with tiles of levels 1 to 7 in dark lead, coloured from a swirling dye field.', size: 'A6', cells: '264 × 366 cells of 0.42 mm', w: 993, h: 1400, pdf: 'postcard-liquid-vortex.pdf', kb: 412 },
  { id: 'liquid-cathedral', title: 'Liquid light: cathedral', text: 'The same stained glass, coloured from a dye field of bubbles in cathedral colours.', size: 'A6', cells: '264 × 366 cells of 0.42 mm', w: 993, h: 1400, pdf: 'postcard-liquid-cathedral.pdf', kb: 424 },
  { id: 'dragon', title: 'The Belfry dragon', text: 'The gilded dragon on top of the Ghent Belfry, tiles of levels 1 to 4, each in one gold, on a night-blue automaton.', size: 'A6, landscape', cells: '366 × 264 cells of 0.42 mm', w: 1400, h: 993, pdf: 'postcard-dragon.pdf', kb: 145 },
];
const prints: Piece[] = [
  { id: 'jury-print-paraty', title: 'Paraty Mirim, land and sea', text: 'Land and sea both packed with tiles: the level rises with the altitude on land and with the distance from the shore at sea. Seven shades of terracotta on land, seven of denim at sea.', size: 'A3', cells: '720 × 1008 cells of 0.42 mm', w: 2807, h: 3970, pdf: 'print-paraty-A3.pdf', kb: 2775 },
];
// The landscape dome comes last, so it spans a whole row in both the three- and the two-column grid.
const posters: Piece[] = [
  { id: 'sacred-mandala-gold', title: 'Mandala in gold', text: 'After a photograph of a Himalayan mandala thangka in green and gold: the big tiles fill its calm fields, the small ones trace the busy parts.', size: 'A2', cells: '1008 × 1422 cells of 0.42 mm', w: 3970, h: 5614, pdf: 'poster-mandala-gold-A2.pdf', kb: 3661 },
  { id: 'sacred-mandala-blue', title: 'Mandala in lapis', text: 'After a photograph of a mandala thangka in red and lapis blue, each tile one pane of colour between seams of dark lead.', size: 'A2', cells: '1008 × 1422 cells of 0.42 mm', w: 3970, h: 5614, pdf: 'poster-mandala-blue-A2.pdf', kb: 3585 },
  { id: 'sacred-mandala-dark', title: 'Mandala in vermilion', text: 'After a photograph of a thangka in black and vermilion: its figures are not symmetric, so they dissolve into fields of colour.', size: 'A2', cells: '1008 × 1422 cells of 0.42 mm', w: 3970, h: 5614, pdf: 'poster-mandala-dark-A2.pdf', kb: 4188 },
  { id: 'sacred-tilework', title: 'Tilework', text: 'After a photograph of a panel of Persian tilework with black grout, mirrored left to right and top to bottom.', size: 'A2', cells: '1008 × 1422 cells of 0.42 mm', w: 3970, h: 5614, pdf: 'poster-tilework-A2.pdf', kb: 3891 },
  { id: 'sacred-dome', title: 'Star dome', text: 'After a photograph of the 16-fold star dome of a Persian ceiling: one wedge of the star, mirrored round the circle, with turquoise seams.', size: 'A2, landscape', cells: '1422 × 1008 cells of 0.42 mm', w: 5614, h: 3970, pdf: 'poster-dome-A2.pdf', kb: 4526 },
];
const all = [...postcards, ...prints, ...posters];
const mb = (kb: number) => (kb >= 1000 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} kB`);
---
<Base title="Gallery" description="Mosaics built from Game of Life still lifes: postcards, an A3 print and A2 posters, with print-quality PDFs." wide>
  <div class="measure">
    <h1>Gallery</h1>
    <p>Mosaics built entirely from Game of Life still lifes: every cell is alive or dead, and every live cell keeps living forever. The postcards and the A3 print were handouts for my PhD defence on 2 October 2026, for the guests and for the jury. The A2 posters are after photographs of sacred geometry: each is one still life, packed with the tiles of my thesis cover and exactly symmetric.</p>
    <p>Click a piece to see it large, and click again to zoom in on the cells; on a phone, pinch or double-tap, and swipe to the next piece. The PDFs are the vector print files, with 3 mm bleed. Make your own with the <a href="https://huggingface.co/spaces/mrollier/game-of-life-mosaics">mosaic app</a>.</p>
  </div>

  <h2>Postcards</h2>
  <ul class="gallery">
    {postcards.map((p) => (
      <li class:list={[p.w > p.h && 'landscape']}>
        <button type="button" class="thumb" data-id={p.id} aria-label={`View ${p.title} large`}>
          <img src={`/gallery/${p.id}.webp`} alt={p.title} width={p.w} height={p.h} loading="lazy" decoding="async" />
        </button>
        <b>{p.title}</b>
        <span class="text">{p.text}</span>
        <span class="meta">{p.size} · {p.cells} · <a href={`/gallery/${p.pdf}`} download>PDF, {mb(p.kb)}</a></span>
      </li>
    ))}
  </ul>

  <h2>Prints</h2>
  <ul class="gallery single">
    {prints.map((p) => (
      <li>
        <button type="button" class="thumb" data-id={p.id} aria-label={`View ${p.title} large`}>
          <img src={`/gallery/${p.id}.webp`} alt={p.title} width={p.w} height={p.h} loading="lazy" decoding="async" />
        </button>
        <b>{p.title}</b>
        <span class="text">{p.text}</span>
        <span class="meta">{p.size} · {p.cells} · <a href={`/gallery/${p.pdf}`} download>PDF, {mb(p.kb)}</a></span>
      </li>
    ))}
  </ul>

  <h2>Posters</h2>
  <ul class="gallery">
    {posters.map((p) => (
      <li class:list={[p.w > p.h && 'landscape']}>
        <button type="button" class="thumb" data-id={p.id} aria-label={`View ${p.title} large`}>
          <img src={`/gallery/${p.id}.webp`} alt={p.title} width={p.w} height={p.h} loading="lazy" decoding="async" />
        </button>
        <b>{p.title}</b>
        <span class="text">{p.text}</span>
        <span class="meta">{p.size} · {p.cells} · <a href={`/gallery/${p.pdf}`} download>PDF, {mb(p.kb)}</a></span>
      </li>
    ))}
  </ul>

  <dialog class="viewer" aria-label="Mosaic viewer">
    <div class="stage"><div class="track">{[0, 1, 2].map(() => <div class="slide"><img alt="" draggable="false" /></div>)}</div></div>
    <div class="bar">
      <span class="cap"></span>
      <button type="button" data-go="-1" aria-label="Previous">←</button>
      <button type="button" data-go="1" aria-label="Next">→</button>
      <button type="button" class="zoom">Zoom</button>
      <a class="dl" download>PDF</a>
      <button type="button" class="close" aria-label="Close">✕</button>
    </div>
  </dialog>
  <script type="application/json" id="gallery-data" set:html={JSON.stringify(all.map(({ id, title, pdf, w, h }) => ({ id, title, pdf, w, h })))} />
</Base>

<style>
  .gallery {
    list-style: none; margin: 0 0 2rem; padding: 0;
    display: grid; gap: 2rem 1.5rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .gallery li { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.9rem; }
  .gallery li.landscape { grid-column: span 2; }
  .gallery.single { grid-template-columns: minmax(0, 560px); }
  .thumb { all: unset; cursor: zoom-in; display: block; margin-bottom: 0.4rem; line-height: 0; }
  .thumb:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .thumb img { width: 100%; box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 4px 14px rgb(0 0 0 / 0.1); transition: transform 0.15s; }
  .thumb:hover img { transform: translateY(-2px); }
  .gallery b { font-family: var(--mono); font-weight: 600; }
  .gallery .text { color: var(--ink); line-height: 1.45; }
  .gallery .meta { color: var(--muted); font-size: 0.82rem; font-family: var(--mono); }
  .gallery .meta a { white-space: nowrap; }
  @media (max-width: 700px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
  }
  @media (max-width: 480px) {
    .gallery .text { display: none; }
  }

  .viewer {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: #0d0e10; color: #e8e9e6;
  }
  .viewer[open] { display: flex; flex-direction: column; overscroll-behavior: contain; }
  .viewer::backdrop { background: #0d0e10; }
  /* three slides side by side (previous, current, next), the current one in view; the script sizes and places each image */
  .stage { flex: 1; min-height: 0; position: relative; overflow: hidden; touch-action: none; cursor: zoom-in; user-select: none; -webkit-user-select: none; }
  .viewer.zoomed .stage { cursor: grab; }
  .track { position: absolute; inset: 0; display: flex; transform: translateX(-100%); }
  .slide { position: relative; flex: none; width: 100%; height: 100%; overflow: hidden; }
  .slide img { position: absolute; left: 0; top: 0; max-width: none; transform-origin: 0 0; pointer-events: none; -webkit-user-drag: none; }
  .bar {
    display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1rem;
    font-family: var(--mono); font-size: 0.85rem; border-top: 1px solid #2a2d33; touch-action: manipulation;
  }
  .bar .cap { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar button, .bar a {
    font: inherit; color: inherit; background: none; border: 1px solid #3a3e45;
    padding: 0.15em 0.7em; cursor: pointer; text-decoration: none;
  }
  .bar button:hover, .bar a:hover { border-color: #9a9ea6; }
</style>

<script>
  // The viewer: three slides side by side (previous, current, next), so a swipe drags the neighbours into view. The
  // current image zooms and pans by pinching, double-tapping and dragging on a touchscreen; by clicking, dragging, a
  // trackpad pinch and the wheel with a mouse. Zoom is a scale s ≥ 1 over the fitted size, up to 2 CSS pixels per image
  // pixel (8 per cell), with the image's centre shifted by (tx, ty); the image is laid out at that size, not scaled with
  // a transform, so the browser draws the cells sharp. A swipe down closes the viewer.
  type Item = { id: string; title: string; pdf: string; w: number; h: number };
  const items: Item[] = JSON.parse(document.getElementById('gallery-data')!.textContent!);
  const dlg = document.querySelector<HTMLDialogElement>('.viewer')!;
  const stage = dlg.querySelector<HTMLDivElement>('.stage')!, track = stage.querySelector<HTMLDivElement>('.track')!;
  const cap = dlg.querySelector<HTMLSpanElement>('.cap')!;
  const dl = dlg.querySelector<HTMLAnchorElement>('.dl')!;
  const zoomBtn = dlg.querySelector<HTMLButtonElement>('.zoom')!;
  let slides = Array.from(track.children) as HTMLElement[]; // previous, current, next
  const imgOf = (el: HTMLElement) => el.querySelector('img')!;
  const mod = (i: number) => (i + items.length) % items.length;
  // at: the current piece; s, tx, ty: its zoom; off: the track dragged sideways; drop: the image dragged down, to close
  let at = 0, s = 1, tx = 0, ty = 0, off = 0, drop = 0;

  /** The fitted size of a piece in the stage, with a margin. */
  const fit = (it: Item) => {
    const W = stage.clientWidth, H = stage.clientHeight, f = Math.max(1e-3, Math.min((W - 32) / it.w, (H - 16) / it.h));
    return { f, w: it.w * f, h: it.h * f, W, H };
  };
  const maxS = () => Math.max(1, 2 / fit(items[at]).f);
  const zoomed = () => s > 1.01;

  function place(el: HTMLElement, i: number, z = 1, x = 0, y = 0) {
    const it = items[mod(i)], g = fit(it), img = imgOf(el), w = g.w * z, h = g.h * z;
    img.style.width = `${w}px`; img.style.height = `${h}px`;
    img.style.transform = `translate(${(g.W - w) / 2 + x}px, ${(g.H - h) / 2 + y}px)`;
    img.style.imageRendering = (w / it.w) * devicePixelRatio >= 2 ? 'pixelated' : 'auto';
  }
  function render() {
    track.style.transform = `translateX(calc(-100% + ${off}px))`;
    place(slides[0], at - 1); place(slides[1], at, s, tx, ty + drop); place(slides[2], at + 1);
    imgOf(slides[1]).style.opacity = drop ? String(Math.max(0.3, 1 - Math.abs(drop) / 400)) : '';
    dlg.classList.toggle('zoomed', zoomed());
    zoomBtn.textContent = zoomed() ? 'Fit' : 'Zoom';
  }
  function load() {
    slides.forEach((el, k) => {
      const it = items[mod(at + k - 1)], img = imgOf(el), src = `/gallery/${it.id}.webp`;
      if (img.getAttribute('src') !== src) img.src = src;
      img.alt = k === 1 ? it.title : '';
    });
    cap.textContent = items[at].title;
    dl.href = `/gallery/${items[at].pdf}`;
  }
  /** Keep a zoomed image over the stage: no empty band at an edge while it is larger than the stage. */
  function clamp() {
    const g = fit(items[at]), mx = Math.max(0, (g.w * s - g.W) / 2), my = Math.max(0, (g.h * s - g.H) / 2);
    tx = Math.min(mx, Math.max(-mx, tx)); ty = Math.min(my, Math.max(-my, ty));
  }
  /** Zoom to z with the stage point (qx, qy) staying put. */
  function zoomAt(z: number, qx: number, qy: number) {
    const g = fit(items[at]), k = z / s;
    tx = qx - g.W / 2 - k * (qx - g.W / 2 - tx); ty = qy - g.H / 2 - k * (qy - g.H / 2 - ty); s = z;
  }

  // one animation at a time; a new one first finishes the old one, so a step to the next piece is never lost
  type State = { s: number; tx: number; ty: number; off: number; drop: number };
  let anim = 0, finish: (() => void) | null = null;
  function settle() { cancelAnimationFrame(anim); const f = finish; finish = null; f?.(); }
  function animate(to: Partial<State>, ms = 240, done?: () => void) {
    settle();
    const from: State = { s, tx, ty, off, drop }, goal: State = { ...from, ...to }, t0 = performance.now();
    const set = (u: number) => { s = from.s + (goal.s - from.s) * u; tx = from.tx + (goal.tx - from.tx) * u; ty = from.ty + (goal.ty - from.ty) * u; off = from.off + (goal.off - from.off) * u; drop = from.drop + (goal.drop - from.drop) * u; };
    finish = () => { set(1); render(); done?.(); };
    const step = (now: number) => {
      const u = Math.min(1, (now - t0) / ms);
      if (u >= 1) { const f = finish; finish = null; f?.(); return; }
      set(1 - (1 - u) ** 3); render(); anim = requestAnimationFrame(step);
    };
    anim = requestAnimationFrame(step);
  }
  /** Animate the zoom to z about the stage point (qx, qy); z = 1 fits the piece again. */
  function zoomTo(z: number, qx: number, qy: number) {
    const keep = { s, tx, ty };
    if (z <= 1) { s = 1; tx = 0; ty = 0; } else { zoomAt(z, qx, qy); clamp(); }
    const goal = { s, tx, ty };
    ({ s, tx, ty } = keep);
    animate(goal);
  }
  const centre = () => [stage.clientWidth / 2, stage.clientHeight / 2] as const;
  function toggleZoom(z: number, qx = centre()[0], qy = centre()[1]) { zoomTo(zoomed() ? 1 : z, qx, qy); }

  /** Slide to the next (1) or previous (−1) piece. The slides rotate, so no image is loaded twice. */
  function go(dir: 1 | -1) {
    settle();
    if (zoomed()) { s = 1; tx = 0; ty = 0; render(); }
    animate({ off: -dir * stage.clientWidth }, 260, () => {
      at = mod(at + dir);
      if (dir > 0) { track.append(slides[0]); slides.push(slides.shift()!); } else { track.prepend(slides[2]); slides.unshift(slides.pop()!); }
      off = 0; s = 1; tx = 0; ty = 0; load(); render();
    });
  }
  function open(i: number) {
    settle();
    at = mod(i); s = 1; tx = 0; ty = 0; off = 0; drop = 0;
    load(); dlg.showModal(); render();
  }

  // ── pointers: one finger (or the mouse) swipes, pans, or taps; two fingers pinch ──
  const pts = new Map<number, { x: number; y: number }>();
  let mode: '' | 'wait' | 'pan' | 'swipe' | 'drop' | 'pinch' = '';
  let x0 = 0, y0 = 0, t0 = 0, s0 = 1, tx0 = 0, ty0 = 0, d0 = 1, mx0 = 0, my0 = 0, lastTap = { t: 0, x: 0, y: 0 };
  const rel = (e: { clientX: number; clientY: number }) => { const r = stage.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
  const one = (p: { x: number; y: number }, t: number) => { x0 = p.x; y0 = p.y; t0 = t; tx0 = tx; ty0 = ty; };

  stage.addEventListener('pointerdown', (e) => {
    if (e.button !== 0) return;
    stage.setPointerCapture(e.pointerId);
    settle();
    const p = rel(e);
    pts.set(e.pointerId, p);
    if (pts.size === 1) { one(p, e.timeStamp); mode = 'wait'; }
    else if (pts.size === 2) {
      const [a, b] = [...pts.values()];
      d0 = Math.hypot(a.x - b.x, a.y - b.y) || 1; mx0 = (a.x + b.x) / 2; my0 = (a.y + b.y) / 2; s0 = s; tx0 = tx; ty0 = ty;
      off = 0; drop = 0; mode = 'pinch'; render();
    }
  });
  stage.addEventListener('pointermove', (e) => {
    if (!pts.has(e.pointerId)) return;
    const p = rel(e), dx = p.x - x0, dy = p.y - y0;
    pts.set(e.pointerId, p);
    if (mode === 'wait' && Math.hypot(dx, dy) > 8) mode = zoomed() ? 'pan' : Math.abs(dx) >= Math.abs(dy) ? 'swipe' : 'drop';
    if (mode === 'pan') { tx = tx0 + dx; ty = ty0 + dy; clamp(); }
    else if (mode === 'swipe') off = dx;
    else if (mode === 'drop') drop = dy;
    else if (mode === 'pinch' && pts.size >= 2) {
      // zoom about where the fingers started, then move with them; a little beyond the limits, which spring back on release
      const [a, b] = [...pts.values()], mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
      const z = Math.min(maxS() * 1.25, Math.max(0.6, (s0 * Math.hypot(a.x - b.x, a.y - b.y)) / d0));
      s = s0; tx = tx0; ty = ty0; zoomAt(z, mx0, my0); tx += mx - mx0; ty += my - my0;
    }
    else return;
    render();
  });
  const end = (e: PointerEvent) => {
    if (!pts.delete(e.pointerId)) return;
    if (mode === 'pinch' || mode === 'pan') {
      // after a pinch the finger left behind pans; when the last one lifts, the zoom springs back within its limits
      if (pts.size === 1) { const [p] = pts.values(); one(p, e.timeStamp); mode = 'pan'; return; }
      if (pts.size) return;
      mode = '';
      if (s < 1) zoomTo(1, 0, 0);
      else if (s > maxS()) zoomTo(maxS(), mx0, my0);
      else { const keep = { tx, ty }; clamp(); const goal = { tx, ty }; ({ tx, ty } = keep); if (goal.tx !== tx || goal.ty !== ty) animate(goal); }
      return;
    }
    if (pts.size) return;
    const p = rel(e), dx = p.x - x0, dy = p.y - y0, dt = Math.max(1, e.timeStamp - t0), m = mode;
    mode = '';
    if (m === 'swipe') {
      if (e.type === 'pointerup' && (Math.abs(dx) > stage.clientWidth * 0.18 || (Math.abs(dx) > 30 && Math.abs(dx) / dt > 0.4))) go(dx < 0 ? 1 : -1);
      else animate({ off: 0 });
    } else if (m === 'drop') {
      if (e.type === 'pointerup' && (Math.abs(dy) > 120 || (Math.abs(dy) > 40 && Math.abs(dy) / dt > 0.5))) dlg.close();
      else animate({ drop: 0 });
    } else if (m === 'wait' && e.type === 'pointerup' && dt < 400) {
      // a click zooms in on the cells at once; on a touchscreen it takes a double tap, to a closer look
      if (e.pointerType === 'mouse') return toggleZoom(maxS(), p.x, p.y);
      const now = performance.now();
      if (now - lastTap.t < 330 && Math.hypot(p.x - lastTap.x, p.y - lastTap.y) < 40) { lastTap.t = 0; toggleZoom(Math.min(maxS(), 4), p.x, p.y); }
      else lastTap = { t: now, x: p.x, y: p.y };
    }
  };
  stage.addEventListener('pointerup', end);
  stage.addEventListener('pointercancel', end);
  // a trackpad pinch arrives as the wheel with Ctrl; the plain wheel pans a zoomed image
  stage.addEventListener('wheel', (e) => {
    e.preventDefault(); settle();
    const p = rel(e);
    if (e.ctrlKey) { const z = Math.min(maxS(), Math.max(1, s * Math.exp(-e.deltaY * 0.01))); zoomAt(z, p.x, p.y); if (z === 1) { tx = 0; ty = 0; } }
    else if (zoomed()) { tx -= e.deltaX; ty -= e.deltaY; }
    else return;
    clamp(); render();
  }, { passive: false });
  stage.addEventListener('gesturestart', (e) => e.preventDefault()); // Safari: no page zoom inside the viewer

  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((b) =>
    b.addEventListener('click', () => open(items.findIndex((it) => it.id === b.dataset.id))),
  );
  zoomBtn.addEventListener('click', () => toggleZoom(maxS()));
  dlg.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go) as 1 | -1)));
  dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('close', () => { settle(); pts.clear(); mode = ''; s = 1; tx = 0; ty = 0; off = 0; drop = 0; });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === 'ArrowRight') go(1);
    else if (e.key === 'z') zoomBtn.click();
  });
  addEventListener('resize', () => { if (dlg.open) { clamp(); render(); } });
</script>

---
// F3–F4: the two curves that read a rule before it runs, the average next density and the average next defect, each
// with a start the reader drags and a cobweb of a few steps showing where the network goes on average; then one red
// line: the tangent at the unstable equilibrium (how unstable) and at the origin (how sensitive); then a click brings in
// the consensus-seeking rule, the one the next chapter goes looking for. Three rules to switch between, shared by both
// slides, its name under them. Drawing in src/scripts/defence/cobweb.ts.
import Slide from './Slide.astro';
import { phi } from './tex';
const rules = [
  { id: 'life', name: 'Game of Life' },
  { id: 'consensus', name: 'Consensus-seeking rule' },
  { id: 'random', name: 'Random rule' },
];
const slides = [
  { kind: 'density', title: 'The average next density', cls: 'f3', builds: 2, say: [
    'Can we say something about a rule before we run it? Take a network in which some share of the nodes is on: its density, from all off on the left to all on on the right. What is the density one round later, on average? That is this curve, the average next density, worked out from the rule alone, as if every node had eight neighbours picked at random. Follow it step by step, up to the curve and across to the diagonal, and this cobweb shows where the network would go on average. On this page you can drag the start (the dot on the bottom axis; the cobweb follows as a ghost and draws itself when you let go), and switch between the Game of Life, a consensus-seeking rule and a random rule; the ↺ next to Random rule draws another one. Under the buttons is the rule’s name.',
    'Where the curve crosses the diagonal, the density stays put: an equilibrium. Some of them pull the network in, others push it away. The red line is the tangent at the unstable one: the steeper it is, the harder the network is pushed away. Its slope says how unstable a rule is. For the Game of Life it is 1.7, at a density of about a fifth; many random rules have no unstable equilibrium at all. All of this is an approximation that ignores who is next to whom, which is why we still simulate.',
    'One more click brings in the consensus-seeking rule, the kind of rule the next chapter goes looking for. Its unstable equilibrium sits at one half, and the same click moves the start to 30% on: the network is pushed away from half and half, here towards all off (from a little over half, towards all on). How we found it comes after the next slide.',
  ], aria: 'The average next density of the chosen rule against the density now, with a cobweb from the start and the diagonal' },
  { kind: 'defect', title: 'The average next defect', cls: 'f4', builds: 3, say: [
    'The second curve asks the same question about differences. Take two copies of a network, identical except for some share of the nodes: the defect, in red. What is the defect one round later, on average? That is the average next defect, again worked out from the rule alone, for a network that is half on and eight neighbours each. The cobweb shows where a small defect goes: in the Game of Life it grows.',
    'The red line is the tangent at the origin: how many nodes a single difference reaches in one round, on average. Its slope says how sensitive a rule is: above one, a single difference spreads; below one, it dies out. For the Game of Life it is about three.',
    'The next click brings back the consensus-seeking rule: more than six. A single difference spreads fast under this rule, and that will matter in the next chapter.',
    'Our result: we worked out both curves for Life-like network automata, so that they can be read off any of the 262 144 rules before running it. They are what the filter on the next slide is made of.',
  ], aria: 'The average next defect of the chosen rule against the defect now, with a cobweb from the start and the diagonal' },
];
---
{slides.map((sl, i) => (
  <Slide id={i ? undefined : 'ch-metrics'} label={sl.title} builds={sl.builds} class={`${sl.cls} avg`} ch={5}>
    <div class="row grow avg-row">
      <div class="col avg-side">
        <h2>{sl.title}</h2>
        <div class="avg-rules" role="group" aria-label="Rule">
          {rules.map((r, i) => (
            <span class="avg-pick">
              <button type="button" class="ctl" data-rule={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>{r.name}</button>
              {r.id === 'random' && <button type="button" class="ctl avg-reroll" data-reroll hidden aria-label="another random rule" title="another random rule">↺</button>}
            </span>
          ))}
        </div>
        <p class="avg-phi" set:html={phi(9, 8, 12, true)} />
        {/* the density slide keeps an invisible copy of the defect slide's box, so the column sits the same on both */}
        {sl.kind === 'defect' ? <p class="result" data-b="3"><b>Our result</b> Both curves, worked out for Life-like network automata: ready to filter the rules.</p>
          : <p class="result avg-spacer" aria-hidden="true"><b>Our result</b> Both curves, worked out for Life-like network automata: ready to filter the rules.</p>}
      </div>
      <canvas class="plot" data-kind={sl.kind} aria-label={sl.aria}></canvas>
    </div>
    {sl.say.map((t) => <p slot="say">{t}</p>)}
  </Slide>
))}

<style>
  .avg-row { gap: calc(40 * var(--u)); align-items: stretch; }
  .avg-side { width: calc(620 * var(--u)); flex: none; gap: calc(44 * var(--u)); justify-content: center; }
  .avg-rules { display: flex; flex-direction: column; align-items: flex-start; gap: calc(16 * var(--u)); }
  .avg-rules .ctl { font-size: calc(32 * var(--u)); padding: calc(14 * var(--u)) calc(26 * var(--u)); }
  .avg-rules .ctl[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--sun); }
  .avg-pick { display: flex; gap: calc(12 * var(--u)); }
  .avg-rules .avg-reroll { font: 700 calc(36 * var(--u)) / 1 var(--sans); padding: calc(8 * var(--u)) calc(18 * var(--u)); }
  .avg-phi { font-size: calc(56 * var(--u)); min-height: 1.6em; }
  .avg-spacer { visibility: hidden; }
  .avg-side .result { font-size: calc(34 * var(--u)); }
  .plot { flex: 1; min-width: 0; height: 100%; touch-action: none; }
</style>

<script>
  import { slide } from '../../scripts/defence/deck';
  import { stage, size, onSize, pointer } from '../../scripts/defence/stage';
  import type { Rule } from '../../scripts/llna';
  import { setPhi } from '../../scripts/defence/donut';
  import { curveOf, tangentOf, box, draw, STEPS, type Kind, type Tangent } from '../../scripts/defence/cobweb';
  import { px, py } from '../../scripts/defence/plot';

  // The rule is shared by both slides: a press on either changes both. Each slide opens on the Game of Life, and its
  // click SWITCH brings in the consensus-seeking rule (Ch. 6's best on rewired grids, the one of the slides after);
  // stepping back over that click brings back the Game of Life. A rule picked by hand stays until a click crosses it.
  // Random rule draws a rule when it is chosen, and its ↺ another one.
  const FIXED: Record<string, Rule> = { life: { r: 9, B: 8, S: 12 }, consensus: { r: 9, B: 488, S: 464 } };
  let pick = 'life', rule: Rule = FIXED.life;
  const listeners: (() => void)[] = [];
  function choose(id: string, again = false) {
    if (id === pick && !again) return;
    pick = id;
    rule = id === 'random' ? { r: 9, B: Math.floor(Math.random() * 512), S: Math.floor(Math.random() * 512) } : FIXED[id];
    for (const f of listeners) f();
  }

  const SWITCH = 2, STEP_MS = 260, MORPH_MS = 450, N = 240, START: Record<Kind, number> = { density: 0.5, defect: 0.05 };
  // where the switch to the consensus-seeking rule puts the start: at half on its density stays put, at 30% on it falls
  const AWAY: Record<Kind, number> = { density: 0.3, defect: 0.05 };
  /** A curve as samples, so a change of rule can morph one into the other. */
  const sample = (f: (x: number) => number) => Float64Array.from({ length: N + 1 }, (_, i) => f(i / N));
  const read = (a: Float64Array, x: number) => { const u = Math.max(0, Math.min(1, x)) * N, i = Math.min(N - 1, Math.floor(u)); return a[i] + (a[i + 1] - a[i]) * (u - i); };

  for (const s of document.querySelectorAll<HTMLElement>('.slide.avg')) {
    const c = s.querySelector<HTMLCanvasElement>('canvas.plot')!, kind = c.dataset.kind as Kind;
    const buttons = Array.from(s.querySelectorAll<HTMLButtonElement>('[data-rule]')), reroll = s.querySelector<HTMLButtonElement>('[data-reroll]')!, name = s.querySelector('.avg-phi')!;
    let f = curveOf(rule, kind), red: Tangent | null = tangentOf(f, kind), at = 0, start = START[kind], progress = STEPS;
    let drag = false; // the start is being dragged
    // a morph from the samples `was` to the new curve, then the cobweb drawn step by step
    let was: Float64Array | null = null, now = sample(f), e = 1, mode: 'still' | 'morph' | 'web' = 'still', t0 = 0, raf = 0;
    const shown = (x: number) => (was ? read(was, x) + (read(now, x) - read(was, x)) * e : f(x));
    function paint() {
      const st = stage(c); if (!st) return;
      draw(st, box(st.w, st.h), { kind, f: shown, start, progress: mode === 'morph' ? 0 : progress, red: at >= 1 && mode !== 'morph' ? red : undefined, handle: true, ghost: drag });
    }
    function frame(t: number) {
      if (mode === 'morph') {
        const u = Math.min(1, (t - t0) / MORPH_MS); e = u < 0.5 ? 2 * u * u : 1 - (-2 * u + 2) ** 2 / 2;
        if (u >= 1) { was = null; mode = 'web'; t0 = t; progress = 0; }
      }
      if (mode === 'web') { progress = Math.min(STEPS, (t - t0) / STEP_MS); if (progress >= STEPS) mode = 'still'; }
      paint();
      raf = mode === 'still' ? 0 : requestAnimationFrame(frame);
    }
    const run = (m: 'morph' | 'web') => { cancelAnimationFrame(raf); mode = m; t0 = performance.now(); if (m === 'web') progress = 0; raf = requestAnimationFrame(frame); };
    const halt = () => { cancelAnimationFrame(raf); raf = 0; was = null; mode = 'still'; progress = STEPS; };
    const mark = () => { buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.rule === pick))); reroll.hidden = pick !== 'random'; setPhi(name, rule); };
    listeners.push(() => {
      // morph from whatever is on screen now to the new rule's curve
      const from = sample(shown);
      f = curveOf(rule, kind); red = tangentOf(f, kind); was = from; now = sample(f); e = 0;
      mark(); run('morph');
    });
    buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.rule!)));
    reroll.addEventListener('click', () => choose('random', true));

    // The start is dragged by its dot on the axis only. While it moves the cobweb is a ghost; let go, and it draws itself.
    const onDot = (ev: PointerEvent) => { const z = size(c), p = box(z.w, z.h), q = pointer(c, ev); return Math.hypot(q.x - px(p, start), q.y - py(p, 0)) < 40; };
    const move = (ev: PointerEvent) => { const z = size(c), p = box(z.w, z.h); start = Math.min(1, Math.max(0, (pointer(c, ev).x - p.x) / p.w)); paint(); };
    const release = () => { if (drag) { drag = false; c.style.cursor = ''; run('web'); } };
    c.addEventListener('pointerdown', (ev) => { if (ev.button !== 0 || !onDot(ev)) return; drag = true; c.setPointerCapture(ev.pointerId); halt(); move(ev); });
    c.addEventListener('pointermove', (ev) => { if (drag) move(ev); else c.style.cursor = onDot(ev) ? 'ew-resize' : ''; });
    c.addEventListener('pointerup', release);
    c.addEventListener('pointercancel', release);

    slide(s, {
      set(b, how) {
        const fresh = b === 0 && how === 'jump', want = b >= SWITCH ? 'consensus' : 'life';
        const cross = how === 'jump' || b === (how === 'next' ? SWITCH : SWITCH - 1);
        at = b;
        if (cross) start = (b >= SWITCH ? AWAY : START)[kind];
        if (cross && pick !== want) { choose(want); return; }
        if (fresh) { run('web'); return; }
        paint();
      },
      leave() { halt(); paint(); },
    });
    onSize(c, paint);
  }
</script>

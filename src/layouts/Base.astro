---
import '../styles/global.css';
const { frontmatter } = Astro.props;
const title: string = Astro.props.title ?? frontmatter?.title ?? 'Michiel Rollier';
const description: string =
  Astro.props.description ??
  frontmatter?.description ??
  'Physicist, cellular automata researcher, moving into AI safety. Also mountains, jungle DJ sets and a co-housing in Ghent.';
const wide: boolean = Astro.props.wide ?? frontmatter?.wide ?? false;
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  ['/about/', 'About'],
  ['/research/', 'Research'],
  ['/projects/', 'Projects'],
  ['/demos/', 'Demos'],
  ['/ai-safety/', 'AI safety'],
  ['/gallery/', 'Gallery'],
  ['/cv/', 'CV'],
];
const more = [
  ['/mountains/', 'Mountains'],
  ['/dj/', 'DJ sets'],
  ['/reading/', 'Reading'],
  ['/ventures/', 'Ventures'],
];
const elsewhere = [
  ['https://github.com/mrollier', 'GitHub'],
  ['https://scholar.google.com/citations?user=KK8sv4IAAAAJ', 'Scholar'],
  ['https://orcid.org/0000-0001-8467-734X', 'ORCID'],
  ['https://www.linkedin.com/in/michiel-rollier-ba0594152', 'LinkedIn'],
  ['https://soundcloud.com/brakgeboren', 'SoundCloud'],
];
// Exact match marks the page; a section prefix (/demos/ on /demos/eca/) marks the ancestor.
const current = (href: string) => {
  const h = href.replace(/\/$/, '');
  return path === h ? 'page' : h && path.startsWith(h + '/') ? 'true' : undefined;
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Michiel Rollier' ? title : `${title} · Michiel Rollier`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <script is:inline>try { if (localStorage.theme === 'dark') document.documentElement.dataset.theme = 'dark'; } catch {}</script>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <canvas id="life" class:list={[path === '' && 'paint']} aria-hidden="true"></canvas>
    <header class="wrap site-header">
      <a class="brand" href="/">Michiel Rollier</a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={current(href)}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <button id="theme" class="theme" type="button" title="Switch theme">dark</button>
    </header>
    <main class:list={['wrap', wide ? 'wide' : 'measure']}>
      <slot />
    </main>
    <footer class="wrap site-footer">
      <ul aria-label="More pages">
        {more.map(([href, label]) => (
          <li><a href={href} aria-current={current(href)}>{label}</a></li>
        ))}
      </ul>
      <ul aria-label="Elsewhere">
        {elsewhere.map(([href, label]) => (
          <li><a href={href} rel="me">{label}</a></li>
        ))}
      </ul>
    </footer>
    <script>
      import tiles from '../data/tiles.json';
      // Conway's Game of Life, faint. The grid starts as a still life assembled from the diamond
      // tiles of game-of-life-mosaics on a torus, so nothing moves (or costs CPU) until someone clicks.
      const c = document.getElementById('life') as HTMLCanvasElement;
      const ctx = c.getContext('2d')!;
      const S = 8;
      let W = 0, H = 0, g = new Uint8Array(0), n = new Uint8Array(0), active = false;
      let s = 2166136261;
      for (const ch of location.pathname) s = Math.imul(s ^ ch.charCodeAt(0), 16777619);
      let seed = s >>> 0 || 1;
      const rnd = () => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return (s >>> 0) / 4294967296; };
      // Tiles are 6L x 6L bits packed MSB first, sorted by population. Expanded once per level.
      const bank: Record<string, Uint8Array[]> = {};
      function expand(level: number) {
        return bank[level] ??= (tiles as Record<string, string[]>)[level].map((b) => {
          const bytes = atob(b);
          return Uint8Array.from({ length: 36 * level * level }, (_, k) => (bytes.charCodeAt(k >> 3) >> (7 - (k & 7))) & 1);
        });
      }
      function mosaic() {
        const level = 3 + Math.floor(rnd() * 3), size = 6 * level, half = 3 * level;
        const set = expand(level), pop = set.map((t) => t.reduce((a, b) => a + b, 0));
        // Whole lattice periods, so the torus itself is a still life and no tile is cut at the edge.
        W = Math.ceil(c.width / S / size) * size; H = Math.ceil(c.height / S / size) * size;
        g = new Uint8Array(W * H); n = new Uint8Array(W * H);
        // Linear density gradient along a random direction: empty sites, then the sparsest tile, up to the densest.
        const th = rnd() * 2 * Math.PI, f = (x: number, y: number) => Math.cos(th) * x - Math.sin(th) * y;
        const ends = [f(0, 0), f(W, 0), f(0, H), f(W, H)], lo = Math.min(...ends), hi = Math.max(...ends);
        const pmin = pop[0], pmax = pop[pop.length - 1];
        for (let j = 0; j < H / half; j++) for (let i = j % 2; i < W / half; i += 2) {
          const x = i * half, y = j * half;
          const want = ((f(x + half, y + half) - lo) / (hi - lo)) * pmax;
          if (want < pmin && rnd() > want / pmin) continue; // below the sparsest tile, thin out to nothing
          // Nearest population, then a random tile among those of that population.
          let k = 0; while (k < pop.length - 1 && Math.abs(pop[k + 1] - want) <= Math.abs(pop[k] - want)) k++;
          let a = k, b = k; while (a > 0 && pop[a - 1] === pop[k]) a--; while (b < pop.length - 1 && pop[b + 1] === pop[k]) b++;
          const t = set[a + Math.floor(rnd() * (b - a + 1))];
          for (let dy = 0; dy < size; dy++) for (let dx = 0; dx < size; dx++) if (t[dy * size + dx]) g[((y + dy) % H) * W + ((x + dx) % W)] = 1;
        }
      }
      // Size the bitmap to the canvas's real CSS box, so cells land where the pointer is. Wipes the bitmap.
      function fit() { const r = c.getBoundingClientRect(); c.width = Math.round(r.width); c.height = Math.round(r.height); }
      function init() {
        fit();
        s = seed; mosaic();
        active = step() > 0;
        console.assert(!active, 'mosaic is not a still life');
      }
      function step() {
        let d = 0;
        for (let y = 0; y < H; y++) {
          const ym = ((y - 1 + H) % H) * W, y0 = y * W, yp = ((y + 1) % H) * W;
          for (let x = 0; x < W; x++) {
            const xm = (x - 1 + W) % W, xp = (x + 1) % W;
            const k = g[ym + xm] + g[ym + x] + g[ym + xp] + g[y0 + xm] + g[y0 + xp] + g[yp + xm] + g[yp + x] + g[yp + xp];
            const v = k === 3 || (k === 2 && g[y0 + x]) ? 1 : 0;
            n[y0 + x] = v; d += v ^ g[y0 + x];
          }
        }
        [g, n] = [n, g];
        return d;
      }
      function draw() {
        ctx.clearRect(0, 0, c.width, c.height);
        ctx.fillStyle = getComputedStyle(c).color;
        for (let i = 0; i < g.length; i++) if (g[i]) ctx.fillRect((i % W) * S, Math.floor(i / W) * S, S - 1, S - 1);
      }
      let run = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      init(); draw();
      new ResizeObserver(() => {
        if (c.width === Math.round(c.clientWidth) && c.height === Math.round(c.clientHeight)) return;
        // Keep the grid while it still covers the viewport (off-screen cells are just clipped). Rebuild only when
        // the window outgrows the torus, from the same seed, so level and angle stay put.
        if (W * S >= c.clientWidth && H * S >= c.clientHeight) fit(); else init();
        draw();
      }).observe(c);
      // Idle while nothing changes. ponytail: a grid left with only blinkers never idles; add period-2 detection if that ever costs anything.
      setInterval(() => { if (run && active && !document.hidden) { active = step() > 0; draw(); } }, 125);

      // Home playground: buttons and painting with the pointer.
      const pause = document.querySelector<HTMLButtonElement>('[data-life=pause]');
      const label = () => { if (pause) pause.textContent = run ? 'pause' : 'play'; };
      label();
      document.querySelectorAll<HTMLButtonElement>('[data-life]').forEach((b) => b.addEventListener('click', () => {
        const k = b.dataset.life;
        if (k === 'pause') run = !run;
        else if (k === 'step') active = step() > 0;
        else if (k === 'clear') { g.fill(0); active = false; }
        else if (k === 'seed') { seed = (Math.random() * 4294967296) >>> 0 || 1; init(); }
        label(); draw();
      }));
      if (c.classList.contains('paint')) {
        let down = false;
        const paint = (e: PointerEvent) => {
          const r = c.getBoundingClientRect();
          const x = Math.floor((e.clientX - r.left) * c.width / r.width / S), y = Math.floor((e.clientY - r.top) * c.height / r.height / S);
          for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) {
            const xx = x + dx, yy = y + dy;
            if (xx >= 0 && yy >= 0 && xx < W && yy < H && Math.random() < 0.6) g[yy * W + xx] = 1;
          }
          active = true; draw();
        };
        addEventListener('pointerdown', (e) => {
          if (e.button !== 0 || (e.target as Element).closest('a, button')) return;
          down = true; paint(e); e.preventDefault();
        });
        addEventListener('pointermove', (e) => { if (down) paint(e); });
        addEventListener('pointerup', () => { down = false; });
        addEventListener('pointercancel', () => { down = false; });
      }

      // Theme toggle. Light is the default; the choice is remembered per browser.
      const t = document.getElementById('theme')!;
      const setLabel = () => { t.textContent = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; };
      setLabel();
      t.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        try { localStorage.theme = dark ? 'dark' : 'light'; } catch {}
        setLabel(); draw();
      });
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import CoverWall from '../components/CoverWall.astro';
const books = (await getCollection('books')).map((b) => b.data);
const when = (b: (typeof books)[number]) => b.readAt ?? b.added ?? '';
const read = books.filter((b) => b.shelf === 'read').sort((a, b) => when(b).localeCompare(when(a)));
const now = books.filter((b) => b.shelf === 'currently-reading');
const pile = books.filter((b) => b.shelf === 'to-read').sort((a, b) => (b.added ?? '').localeCompare(a.added ?? ''));
// Custom Goodreads shelves become filters when at least a few read books carry them.
const tally = new Map<string, number>();
for (const b of read) for (const s of b.shelves) if (s !== 'to-read') tally.set(s, (tally.get(s) ?? 0) + 1);
const shelves = [...tally].filter(([, n]) => n >= 3).sort((a, b) => b[1] - a[1]);
const rated = read.filter((b) => b.rating);
const avg = rated.length ? (rated.reduce((s, b) => s + b.rating, 0) / rated.length).toFixed(1) : null;
---
<Base title="Reading" description="The books I have read and the pile I still mean to, from my Goodreads shelves." wide>
  <div class="measure">
    <h1>Reading</h1>
    <p>
      What I've read, most recent first, from my <a href="https://www.goodreads.com/review/list/176815309">Goodreads</a> shelves.
      {' '}{read.length} finished{avg && `, rated ${avg} on average`}; {pile.length} on the pile.
    </p>
  </div>
  {now.length > 0 && (
    <>
      <h2>Reading now</h2>
      <CoverWall items={now} kind="books" />
    </>
  )}
  <h2>Read</h2>
  {shelves.length > 0 && (
    <div class="filters" role="group" aria-label="Filter by shelf" data-filters>
      <button type="button" data-shelf="" aria-pressed="true">all {read.length}</button>
      {shelves.map(([s, n]) => (
        <button type="button" data-shelf={s} aria-pressed="false">{s} {n}</button>
      ))}
    </div>
  )}
  <CoverWall items={read} kind="books" />
  <h2>The pile</h2>
  <details class="more">
    <summary>{pile.length} books I still mean to read</summary>
    <ul class="pile">
      {pile.map((b) => (
        <li><a href={b.url}>{b.title}</a> <span class="meta">{b.author}</span></li>
      ))}
    </ul>
  </details>
</Base>

<script>
  // Shelf filter: purely cosmetic, every book is in the markup and shows without JavaScript.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  const wall = bar?.nextElementSibling;
  if (bar && wall) {
    bar.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('button[data-shelf]');
      if (!b) return;
      const shelf = b.dataset.shelf ?? '';
      bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      wall.querySelectorAll<HTMLElement>('li').forEach((li) => {
        li.hidden = !!shelf && !(li.dataset.shelves ?? '').split(' ').includes(shelf);
      });
    });
  }
</script>

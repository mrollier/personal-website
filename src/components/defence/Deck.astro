---
// The public PhD defence as one deck. On the page (`mode="page"`) the talk's blocks are hash-routed tabs and every
// slide is a live card; Present puts the same slides fullscreen, one at a time, driven by a clicker. The standalone
// route (`mode="present"`) renders the deck alone behind a Start gate, and is what the offline single file is built
// from. Engine: src/scripts/defence/deck.ts. Everything here lifts out with src/components/defence/ and src/scripts/defence/.
import 'katex/dist/katex.min.css';
import './deck.css';
import Opening from './Opening.astro';
import BeACell from './BeACell.astro';
import Automata from './Automata.astro';
import Question from './Question.astro';
import ThesisMap from './ThesisMap.astro';
import Networks from './Networks.astro';
import Metrics from './Metrics.astro';
import Needle from './Needle.astro';
import WhichNetwork from './WhichNetwork.astro';
import Stubborn from './Stubborn.astro';
import Closing from './Closing.astro';
import Backup from './Backup.astro';
import Hud from './Hud.astro';
type Props = { mode: 'page' | 'present' };
const { mode } = Astro.props;
const page = mode === 'page';
// until: when the block should be over, for the rehearsal clock (key t)
const blocks = [
  { id: 'opening', name: 'Opening', until: '0:30', C: Opening, intro: 'The title, over a landscape of still lifes in the style of the book’s cover.' },
  { id: 'experiment', name: 'An experiment', until: '5:00', C: BeACell, intro: 'A cold start: for five rounds the room follows one rule about two neighbours each, and only afterwards sees what it computed: the parity rule, and a cellular automaton.' },
  { id: 'automata', name: 'Cellular automata', until: '9:00', C: Automata, intro: 'From the parity rule to all 256 elementary rules of a row of cells; the Game of Life in two dimensions, the machines it can build and the still lifes the cover is made of; and the Life-like rules around it, which again behave in very different ways.' },
  { id: 'networks', name: 'Life on networks', until: '11:20', C: Networks, intro: 'From elementary cellular automata (one long row, as in the experiment) to Life-like ones (a grid) to Life-like network automata (links anywhere in the room, where some have four contacts and some thirteen). Such a rule looks at the share of neighbours that are on: two rings of intervals round a node, born and survive, ever finer, so there is no end to these rules; defining them properly is the first contribution of the thesis. Then three of them on three kinds of network.' },
  { id: 'question', name: 'The question', until: '13:40', C: Question, intro: 'Nature uses the same recipe, in a flock of starlings and in a brain: simple local rules on a network, rich behaviour. The rule against what it does, the genotype against the phenotype, and the research question: what links a simple local rule to the rich behaviour it produces, and can we put that link to use?' },
  { id: 'map', name: 'The thesis map', until: '14:30', C: ThesisMap, intro: 'The four parts of the thesis and where they were published; which chapters answer which half of the question; and the four of them that then run along the bottom of the slides: getting to know the rules (metrics, synchronisation) and applying them (network classification, impact analysis).' },
  { id: 'metrics', name: 'Metrics', until: '17:30', C: Metrics, intro: 'Two curves read off a rule before it runs, the average next density and the average next defect, each with a start to drag, a cobweb showing where the network goes on average, and three rules to switch between; then the red line on each: how unstable the rule is, and how sensitive.' },
  { id: 'synchronisation', name: 'Synchronisation', until: '21:30', C: Needle, intro: 'How the two metrics narrow 262 144 rules down to 27 candidates for synchronisation without a single simulation; the best one at work; and its mirror image, which seeks consensus.' },
  { id: 'classification', name: 'Network classification', until: '26:00', C: WhichNetwork, intro: 'Run one rule on a network and the pattern it draws gives the network away. Why some rules are better detectives than others: jaggedness. And what consensus-seeking rules are good at instead.' },
  { id: 'impact', name: 'Impact analysis', until: '29:30', C: Stubborn, intro: 'Make one person stubborn and see whether the room follows: the dynamical importance of every node, found by simulation alone.' },
  { id: 'closing', name: 'Closing', until: '34:00', C: Closing, intro: 'Our answers to the research question, chapter by chapter; three directions beyond the thesis; and the title’s slogan over the landscape, until one cell changes.' },
  { id: 'questions', name: 'Questions', until: '', C: Backup, intro: 'Backup slides for the questions afterwards. In the deck they are reached with the key a and the index.' },
];
---
{page ? (
  <div class="tabbed">
    <nav class="tabs" aria-label="Parts of the talk">
      <ul role="tablist" aria-orientation="vertical">
        {blocks.map((b, i) => <li><a role="tab" id={`tab-${b.id}`} href={`#${b.id}`} aria-controls={b.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><small>{i ? blocks[i - 1].until : '0:00'}</small>{b.name}</a></li>)}
      </ul>
    </nav>
    <div class="deck" id="deck" data-deck tabindex="-1">
      {blocks.map(({ id, name, until, C, intro }, i) => (
        <section role="tabpanel" class="block" id={id} aria-labelledby={`tab-${id}`} data-until={until} hidden={i > 0}>
          <p class="intro">{intro}</p>
          <C />
        </section>
      ))}
      <Hud />
    </div>
  </div>
) : (
  <div class="deck presenting full" id="deck" data-deck data-standalone tabindex="-1">
    {blocks.map(({ id, until, C }) => <div class="block" data-block={id} data-until={until}><C /></div>)}
    <Hud exit={false} />
    <div class="gate" data-gate>
      <div>
        <button type="button">Start</button>
        <p>fullscreen · or press the clicker to start in this window</p>
      </div>
    </div>
  </div>
)}
<script>
  import { mountDeck } from '../../scripts/defence/deck';
  import { sprigs } from '../../scripts/defence/sprig';
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((d) => { mountDeck(d); sprigs(d); });

  // The hash picks the tab (a tab's id or the id of anything inside one); leaving the deck opens the tab it ended on.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tabs [role="tab"]'));
  if (tabs.length) {
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const box = document.querySelector<HTMLElement>('.tabbed')!;
    const show = (id: string, scroll: boolean) => {
      let i = tabs.findIndex((t) => t.getAttribute('aria-controls') === id), target: HTMLElement | null = null;
      if (i < 0) { target = id ? document.getElementById(id) : null; const p = target?.closest<HTMLElement>('[role="tabpanel"]'); i = p ? panels.indexOf(p) : 0; }
      if (i < 0) i = 0;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; panels[k].hidden = k !== i; });
      if (target) target.scrollIntoView({ block: 'start' });
      else if (scroll && scrollY > box.offsetTop) box.scrollIntoView({ block: 'start' });
    };
    const fromHash = () => show(decodeURIComponent(location.hash.slice(1)), true);
    addEventListener('hashchange', fromHash);
    fromHash();
    document.querySelector('.tabs [role="tablist"]')!.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key, i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      const n = tabs.length, j = k === 'ArrowDown' || k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowUp' || k === 'ArrowLeft' ? (i + n - 1) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1;
      if (j < 0) return;
      e.preventDefault(); location.hash = tabs[j].getAttribute('aria-controls')!; tabs[j].focus();
    });
    document.getElementById('deck')!.addEventListener('deck:exit', (e) => {
      const p = ((e as CustomEvent).detail as HTMLElement).closest<HTMLElement>('[role="tabpanel"]');
      if (p && p.hidden) history.replaceState(null, '', `#${p.id}`), show(p.id, false);
    });
  }
</script>

<style>
  /* the page's colours, captured before .deck swaps in the slides' own, for what sits around the cards */
  .tabbed { --page-ink: var(--ink); --page-muted: var(--muted); --page-line: var(--line); --page-accent: var(--accent); }
  .tabbed { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0 2rem; align-items: start; margin-top: 1.5rem; }
  .tabs { position: sticky; top: 1rem; min-width: 0; }
  .tabs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.15rem; border-left: 1px solid var(--line); }
  .tabs a {
    display: block; padding: 0.3rem 0.8rem; margin-left: -1px; border-left: 2px solid transparent;
    color: var(--muted); text-decoration: none; font-size: 0.95rem;
  }
  .tabs small { display: block; font-family: var(--mono); font-size: 0.7em; color: var(--muted); }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-selected="true"] { color: var(--ink); border-left-color: var(--accent); font-weight: 600; }
  .intro { color: var(--page-muted); margin: 0 0 1rem; max-width: 68ch; }
  @media (max-width: 800px) {
    .tabbed { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .tabs { top: 0; z-index: 5; background: var(--bg); padding: 0.4rem 0; }
    .tabs ul { flex-direction: row; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; border-left: 0; border-bottom: 1px solid var(--line); gap: 0; }
    .tabs a { white-space: nowrap; margin: 0 0 -1px; border-left: 0; border-bottom: 2px solid transparent; padding: 0.3rem 0.7rem; }
    .tabs small { display: none; }
    .tabs a[aria-selected="true"] { border-bottom-color: var(--accent); }
  }
</style>

---
import '../styles/global.css';
const { frontmatter } = Astro.props;
const title: string = Astro.props.title ?? frontmatter?.title ?? 'Michiel Rollier';
const description: string =
  Astro.props.description ??
  frontmatter?.description ??
  'Physicist, cellular automata researcher, moving into AI safety. Also mountains, jungle DJ sets and a co-housing in Ghent.';
const wide: boolean = Astro.props.wide ?? frontmatter?.wide ?? false;
const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  ['/about/', 'About'],
  ['/research/', 'Research'],
  ['/projects/', 'Projects'],
  ['/ai-safety/', 'AI safety'],
  ['/gallery/', 'Gallery'],
  ['/cv/', 'CV'],
];
const more = [
  ['/mountains/', 'Mountains'],
  ['/dj/', 'DJ sets'],
  ['/ventures/', 'Ventures'],
];
const elsewhere = [
  ['https://github.com/mrollier', 'GitHub'],
  ['https://scholar.google.com/citations?user=KK8sv4IAAAAJ', 'Scholar'],
  ['https://orcid.org/0000-0001-8467-734X', 'ORCID'],
  ['https://www.linkedin.com/in/michiel-rollier-ba0594152', 'LinkedIn'],
  ['https://soundcloud.com/brakgeboren', 'SoundCloud'],
];
const current = (href: string) => (path === href.replace(/\/$/, '') ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Michiel Rollier' ? title : `${title} · Michiel Rollier`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <canvas id="life" aria-hidden="true"></canvas>
    <header class="wrap site-header">
      <a class="brand" href="/">
        <svg viewBox="0 0 3 3" shape-rendering="crispEdges" aria-hidden="true" fill="currentColor">
          <rect x="1" y="0" width="1" height="1" /><rect x="2" y="1" width="1" height="1" /><rect x="0" y="2" width="3" height="1" />
        </svg>
        Michiel Rollier
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={current(href)}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main class:list={['wrap', wide ? 'wide' : 'measure']}>
      <slot />
    </main>
    <footer class="wrap site-footer">
      <ul aria-label="More pages">
        {more.map(([href, label]) => (
          <li><a href={href} aria-current={current(href)}>{label}</a></li>
        ))}
      </ul>
      <ul aria-label="Elsewhere">
        {elsewhere.map(([href, label]) => (
          <li><a href={href} rel="me">{label}</a></li>
        ))}
      </ul>
    </footer>
    <script>
      // Conway's Game of Life, faint, seeded by the page path so each page has its own soup.
      const c = document.getElementById('life') as HTMLCanvasElement;
      const ctx = c.getContext('2d')!;
      const S = 12;
      let W = 0, H = 0, g = new Uint8Array(0), n = new Uint8Array(0);
      let s = 2166136261;
      for (const ch of location.pathname) s = Math.imul(s ^ ch.charCodeAt(0), 16777619);
      s = s >>> 0 || 1;
      const rnd = () => { s ^= s << 13; s ^= s >>> 17; s ^= s << 5; return (s >>> 0) / 4294967296; };
      function init() {
        c.width = innerWidth; c.height = innerHeight;
        W = Math.ceil(c.width / S); H = Math.ceil(c.height / S);
        g = new Uint8Array(W * H); n = new Uint8Array(W * H);
        for (let i = 0; i < g.length; i++) g[i] = rnd() < 0.15 ? 1 : 0;
      }
      function step() {
        for (let y = 0; y < H; y++) {
          const ym = ((y - 1 + H) % H) * W, y0 = y * W, yp = ((y + 1) % H) * W;
          for (let x = 0; x < W; x++) {
            const xm = (x - 1 + W) % W, xp = (x + 1) % W;
            const k = g[ym + xm] + g[ym + x] + g[ym + xp] + g[y0 + xm] + g[y0 + xp] + g[yp + xm] + g[yp + x] + g[yp + xp];
            n[y0 + x] = k === 3 || (k === 2 && g[y0 + x]) ? 1 : 0;
          }
        }
        [g, n] = [n, g];
      }
      function draw() {
        ctx.clearRect(0, 0, c.width, c.height);
        ctx.fillStyle = getComputedStyle(c).color;
        for (let i = 0; i < g.length; i++) if (g[i]) ctx.fillRect((i % W) * S, Math.floor(i / W) * S, S - 1, S - 1);
      }
      init(); draw();
      addEventListener('resize', () => { init(); draw(); });
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(() => { if (!document.hidden) { step(); draw(); } }, 250);
      }
    </script>
  </body>
</html>

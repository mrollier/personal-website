---
// F2a and F4a: what a rule says before it runs, Ch. 5, as two numbers on the rule's two rings, each slide a plain
// question: the Hamming weight (the share of a node's 512 inputs that turn it on, so the average next density from half
// on), and the Boolean sensitivity (how many of a node's nine inputs change its next state when flipped, a red arrow on
// the rings for one neighbour flipped). Each number is a point or a slope of a curve that Ch. 5 works out too (the
// mean-field and the Derrida curve); the talk leaves those out and shows them only in the mission's race tiles. Each
// slide opens on the Game of Life, and a click brings in the consensus-seeking rule the next chapter goes looking for;
// two buttons switch between them, shared by both slides, the rule's name under them. Drawing in donut.ts.
import Slide from './Slide.astro';
import { phi, tex, texify } from './tex';
const rules = [
  { id: 'life', name: 'Game of Life' },
  { id: 'consensus', name: 'Consensus-seeking rule' },
];
const HW = String.raw`$\mathrm{HW}_8 = \frac{1}{2^9}\sum_{s\in\{0,1\}}\sum_{q=0}^{8}\binom{8}{q}\,\phi(s, q/8)$`;
const BS = String.raw`$\mathrm{BS}_8 = \frac{1}{2^9}\sum_{s\in\{0,1\}}\sum_{q=0}^{8}\binom{8}{q}\big(\mathrm{IS}(s,q,8)+\mathrm{NS}(s,q,8)\big)$`;
const RESULT = 'Metrics for LLNAs, read off the rule before it runs';
const slides = [
  { kind: 'density', label: 'Hamming weight', title: 'How often does a node switch on?', cls: 'f2a', builds: 1, num: 'Hamming weight', sym: String.raw`\mathrm{HW}_8`, first: '0.27', say: [
    `Can we say something about a rule before we run it? Start with one number. Take a node and its eight neighbours, each on or off at random, as in a network that is half on: 512 possible inputs. The rule’s two rings say which of them turn the node on: born, round a node that is off, and survive, round one that is on. The share of the 512 inputs that turn it on is the Hamming weight, ${HW}: each slice counts as often as there are neighbourhoods in it, so the slices at the bottom of the rings, around half on, count the most. It is the average next density from half on. For the Game of Life it is 0.27: from half on, about a quarter of the nodes is on one timestep later. (From any other start the same question gives a curve, the average next density or mean-field curve, which Chapter 5 works out too; the talk shows those curves only briefly, in the race of the next chapter.) On this page the buttons switch between the Game of Life and a consensus-seeking rule; the two slides of this chapter share the rule, and its name is under the buttons.`,
    'One click brings in the consensus-seeking rule, the kind of rule the next chapter goes looking for: 0.50. It treats on and off alike, so from half on it stays at half on, on average.',
  ], aria: 'The rule as two rings, born round a node that is off and survive round a node that is on, with its Hamming weight under them' },
  { kind: 'defect', label: 'Boolean sensitivity', title: 'How much does one neighbour matter?', cls: 'f4a', builds: 2, num: 'Boolean sensitivity', sym: String.raw`\mathrm{BS}_8`, first: '3.17', say: [
    `The second number is about differences. Take the same node and its eight neighbours, and flip one of its nine inputs. Flip a neighbour, and the share of neighbours on moves one slice along the ring, one way or the other: the red arrows. Flip the node itself, and it moves to the other ring. Does the node’s next state change? Count the inputs whose flip changes it, averaged over all 512 inputs: that is the Boolean sensitivity, ${BS}, split into the node itself (IS) and its neighbours (NS), at most 9. For the Game of Life it is 3.17: of a node’s nine inputs, about three matter. It is also how many nodes a single difference reaches in one timestep, on average: above one, a difference spreads. (Chapter 5 follows a difference of any size too, the average next defect or Derrida curve; its slope at the origin is this number.)`,
    'The consensus-seeking rule: 6.40, twice as sensitive as the Game of Life. A single difference spreads fast under this rule, and that will matter in the next chapter.',
    'Our result: we worked out these numbers, and the two curves behind them, for Life-like network automata, so that they can be read off any of the 262 144 rules before running it. They are what the filter of the next slide is made of.',
  ], aria: 'The rule as two rings, with a red arrow along each for one neighbour flipped, and its Boolean sensitivity under them' },
];
---
{slides.map((sl, i) => (
  <Slide id={i ? undefined : 'ch-metrics'} label={sl.label} builds={sl.builds} class={`${sl.cls} avg`} ch={5}>
    <div class="row grow avg-row">
      <div class="col avg-side">
        <h2>{sl.title}</h2>
        <div class="avg-rules" role="group" aria-label="Rule">
          {rules.map((r, i) => <button type="button" class="ctl" data-rule={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>{r.name}</button>)}
        </div>
        <p class="avg-phi" set:html={phi(9, 8, 12, true)} />
        {/* the first slide keeps an invisible copy of the second's box, so the column sits the same on both */}
        {i === slides.length - 1 ? <p class="result" data-b="2"><b>Our result</b> {RESULT}</p>
          : <p class="result avg-spacer" aria-hidden="true"><b>Our result</b> {RESULT}</p>}
      </div>
      <div class="col avg-ring">
        <canvas class="rings" data-kind={sl.kind} aria-label={sl.aria}></canvas>
        <p class={`avg-num ${sl.kind}`}><b>{sl.num}</b><span set:html={tex(`${sl.sym} = \\htmlClass{avg-v}{${sl.first}}`)} /></p>
      </div>
    </div>
    {sl.say.map((t) => <p slot="say" set:html={texify(t)} />)}
  </Slide>
))}

<style>
  .avg-row { gap: calc(40 * var(--u)); align-items: stretch; }
  .avg-side { width: calc(620 * var(--u)); flex: none; gap: calc(44 * var(--u)); justify-content: center; }
  .avg-rules { display: flex; flex-direction: column; align-items: flex-start; gap: calc(16 * var(--u)); }
  .avg-rules .ctl { font-size: calc(32 * var(--u)); padding: calc(14 * var(--u)) calc(26 * var(--u)); }
  .avg-rules .ctl[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--sun); }
  .avg-phi { font-size: calc(56 * var(--u)); min-height: 1.6em; }
  .avg-spacer { visibility: hidden; }
  .avg-side .result { font-size: calc(36 * var(--u)); }
  /* the rings, and under them their number, in the colour of its curve */
  .avg-ring { flex: 1; min-width: 0; align-items: center; justify-content: center; gap: calc(20 * var(--u)); }
  .rings { width: 100%; height: calc(600 * var(--u)); }
  .avg-num { display: flex; align-items: baseline; gap: calc(36 * var(--u)); font-size: calc(52 * var(--u)); }
  .avg-num b { font-weight: 700; }
  .avg-num.density b { color: var(--accent); }
  .avg-num.defect b { color: var(--danger); }
  .avg-num :global(.katex) { font-size: 1.15em; }
</style>

<script>
  import { slide } from '../../scripts/defence/deck';
  import { stage, onSize } from '../../scripts/defence/stage';
  import type { Rule } from '../../scripts/llna';
  import { hammingWeight } from '../../scripts/llna';
  import { sensitivity } from '../../scripts/genotype';
  import { setPhi, drawRing, hop, type Ring } from '../../scripts/defence/donut';

  // The rule is shared by the two slides: a press on either changes both. Each slide opens on the Game of Life, and its
  // click brings in the consensus-seeking rule (Ch. 6's best on rewired grids, the one of the slides after); stepping
  // back over the click brings back the Game of Life. A rule picked by hand stays until a click crosses that build.
  const RULES: Record<string, Rule> = { life: { r: 9, B: 8, S: 12 }, consensus: { r: 9, B: 488, S: 464 } };
  let pick = 'life', rule: Rule = RULES.life;
  const listeners: (() => void)[] = [];
  function choose(id: string) {
    if (id === pick) return;
    pick = id; rule = RULES[id];
    for (const f of listeners) f();
  }
  const AT = 1;
  /** Whether going to build b crosses the click that brings in the consensus-seeking rule. */
  const crosses = (b: number, how: string) => how === 'jump' || (how === 'next' ? b === AT : b === AT - 1);

  // ── the rings with their number: the Hamming weight, or the Boolean sensitivity with a red arrow along each ring for
  // one neighbour flipped (from the middle slice, into the next one either way) ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.avg')) {
    const c = s.querySelector<HTMLCanvasElement>('canvas.rings')!, kind = c.dataset.kind, v = s.querySelector('.avg-v')!;
    const buttons = Array.from(s.querySelectorAll<HTMLButtonElement>('[data-rule]')), name = s.querySelector('.avg-phi')!;
    function paint() {
      v.textContent = (kind === 'density' ? hammingWeight(rule, 8) : sensitivity(rule, 8).BS).toFixed(2);
      const st = stage(c); if (!st) return;
      const R = Math.min(st.w / 4 - 40, st.h / 2 - 50), w = R * 0.41;
      const rings: Ring[] = [{ x: st.w / 2 - R - 70, y: st.h / 2, R, w, on: false }, { x: st.w / 2 + R + 70, y: st.h / 2, R, w, on: true }];
      drawRing(st, rings[0], rule.r, rule.B); drawRing(st, rings[1], rule.r, rule.S);
      if (kind === 'defect') for (const g of rings) hop(st, g, rule.r, 3.7, 5.3, st.t.danger);
    }
    const mark = () => { buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.rule === pick))); setPhi(name, rule); };
    buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.rule!)));
    listeners.push(() => { mark(); paint(); });
    slide(s, {
      set(b, how) {
        if (crosses(b, how)) choose(b >= AT ? 'consensus' : 'life');
        paint();
      },
    });
    onSize(c, paint);
  }
</script>

---
// One 16:9 slide of the defence deck. `builds` is how many clicker steps it has before the deck moves on; the
// slide's own script registers what they do (src/scripts/defence/deck.ts). Everything inside is laid out in
// design pixels of a 1920 × 1080 slide through `--u`, so the card on the page and the projector look the same.
// `ch` puts the thesis ribbon along the bottom with that chapter filled (0: none). The `say` slot is what the
// speaker says, in prose, under the card on the page; the deck never shows it. Behind everything, a few faint tiles of the
// cover peek in from the edge (src/scripts/defence/sprig.ts), wherever they fit: last in the slide, so a script's
// querySelector('canvas') still finds its own first, and kept behind by z-index.
import Ribbon from './Ribbon.astro';
type Props = { builds?: number; appendix?: boolean; label: string; class?: string; id?: string; ch?: number };
const { builds = 0, appendix = false, label, class: cls, id, ch } = Astro.props;
---
<section class:list={['slide', cls, ch !== undefined && 'ribboned']} id={id} data-slide data-builds={builds} data-appendix={appendix ? '' : undefined} aria-label={label}>
  <div class="frame"><slot /></div>
  {ch !== undefined && <Ribbon ch={ch} />}
  <canvas class="sprig" data-sprig aria-hidden="true"></canvas>
</section>
{Astro.slots.has('say') && <div class="say"><slot name="say" /></div>}

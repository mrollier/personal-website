---
// Rule 90 as the room plays it: how many of your two neighbours have a hand up (0, 1 or 2; which one does not
// matter), and what your hand does next. Large on the rule slide, small on the rounds slide, so nobody has to
// remember the rule during a countdown. `width` is one panel's width in design pixels.
type Props = { width?: number };
const { width = 360 } = Astro.props;
const panels = [
  { up: 0, out: 0, then: 'hand down' },
  { up: 1, out: 1, then: 'hand up' },
  { up: 2, out: 0, then: 'hand down' },
];
const who = (up: boolean) => (up ? '#hand-up' : '#hand-down');
const cls = (up: boolean) => (up ? 'up' : 'down');
---
<div class="panels" style={`--pw: ${width}`}>
  {panels.map((p) => (
    <figure class="panel">
      <p class="n"><b>{p.up}</b> up</p>
      <svg viewBox="0 0 300 390" aria-hidden="true">
        <rect class="pair" x="6" y="6" width="288" height="152" rx="24" />
        <use href={who(p.up >= 1)} class={cls(p.up >= 1)} x="36" y="18" width="100" height="130" />
        <use href={who(p.up >= 2)} class={cls(p.up >= 2)} x="164" y="18" width="100" height="130" />
        <path d="M150 178 V224 M132 206 L150 226 L168 206" class="arrow" />
        <use href={who(!!p.out)} class={`${cls(!!p.out)} you`} x="100" y="244" width="100" height="130" />
      </svg>
      <figcaption>→ <b>{p.then}</b></figcaption>
    </figure>
  ))}
</div>

<style>
  .panels { display: flex; gap: calc(var(--pw) * 0.55 * var(--u)); justify-content: center; }
  .panel { margin: 0; width: calc(var(--pw) * var(--u)); display: flex; flex-direction: column; align-items: center; gap: calc(var(--pw) * 0.03 * var(--u)); }
  .panel .n { font-size: calc(var(--pw) * 0.13 * var(--u)); line-height: 1; }
  .panel .n b { font-size: 1.5em; }
  .panel svg { width: 100%; }
  .panel .pair { fill: none; stroke: var(--line); stroke-width: 3; }
  .panel .you.down { stroke: var(--accent); }
  .panel .you.up { fill: var(--accent); stroke: var(--accent); }
  .panel .arrow { fill: none; stroke: var(--muted); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .panel figcaption { font-size: calc(var(--pw) * 0.1 * var(--u)); text-align: center; line-height: 1.25; }
</style>

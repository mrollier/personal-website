---
// E1: the thesis map: four parts, their chapters, where each was published, the ones skipped tonight hollow (said out
// loud, not written). Then the two halves of the research question land on the two parts that answer them, and the
// four chapters of the talk fly down into the ribbon that runs along the bottom of every slide after this one, two by
// two: getting to know the rules, applying them. The groundwater paper waits for the end.
import Slide from './Slide.astro';
import { PARTS, HALVES } from '../../scripts/defence/ribbon';
const where: Record<number, string> = {
  2: 'CNSNS 2025', 3: '', 4: 'under review', 5: 'Physica D 2025', 6: 'Physica D 2025',
  7: 'ACRI 2024', 8: 'Springer 2025', 9: 'under review', 10: 'work in progress',
};
const half: Record<string, string> = { II: 'What links rule and behaviour?', IV: 'Can we put that link to use?' };
const talk = new Set(HALVES.flatMap((h) => h.chs.map((c) => c.ch)));
---
<Slide label="The thesis in one slide" builds={2} class="e1" ch={0}>
  <h2>The thesis in one slide</h2>
  <div class="parts">
    {PARTS.map((p) => (
      <section class:list={['part', p.chs.every((c) => c.skip) && 'skip']}>
        <p class="pn">Part {p.n}</p>
        <h3>{p.name}</h3>
        <ul>
          {p.chs.map((c) => <li class:list={[c.skip && 'skip', talk.has(c.ch) && 'talk']}><span class="ch"><b>{c.ch}</b> <span class="nm" data-ch={c.ch}>{c.name}</span></span>{where[c.ch] && <span class="where">{where[c.ch]}</span>}</li>)}
        </ul>
        {half[p.n] && <p class="half" data-b="1">{half[p.n]}</p>}
      </section>
    ))}
  </div>
  <p slot="say">The thesis has four parts. Part I sets the stage: a taxonomy of the many kinds of cellular automata (<em>A comprehensive taxonomy of cellular automata</em>, CNSNS 2025) and the networks they can live on. Part II is about rules and their metrics: exact growth rates of defects for the simplest rules (under review, and too technical for tonight), and the metrics and the synchronisers of <em>Essential metrics for Life on graphs</em> (Physica D 2025). Part III, skipped tonight, is about cellular automata and neural networks (ACRI 2024 and a Springer book chapter, 2025). Part IV uses rules as instruments in network science: network classification (under review in Information Sciences, first author Lucas C. de Oliveira), and impact analysis, which node matters (unpublished, work in progress).</p>
  <p slot="say">The two halves of the research question fall on two parts: Part II asks what links a rule and its behaviour, Part IV puts that link to use.</p>
  <p slot="say">Four chapters make up the rest of the talk, two for each half: getting to know the rules (metrics, synchronisation) and applying them (network classification, impact analysis). They drop to the bottom of the screen and stay there, with the current one filled, so you can always see where we are.</p>
</Slide>

<style>
  .parts { display: grid; grid-template-columns: repeat(4, 1fr); gap: calc(32 * var(--u)); flex: 1; min-height: 0; margin-top: calc(44 * var(--u)); }
  .part { border-top: calc(6 * var(--u)) solid var(--ink); padding-top: calc(20 * var(--u)); display: flex; flex-direction: column; gap: calc(16 * var(--u)); }
  .part.skip { border-top-style: dashed; border-top-color: var(--line); }
  .part.skip .pn, .part.skip h3 { opacity: 0.6; } /* a part tonight skips altogether, greyed like its chapters */
  .pn { font-size: calc(30 * var(--u)); font-weight: 700; color: var(--accent); }
  .part h3 { font-size: calc(40 * var(--u)); min-height: 2.4em; }
  .part ul { list-style: none; padding: 0; gap: calc(16 * var(--u)); }
  .part li { border: calc(3 * var(--u)) solid var(--line); background: var(--panel); padding: calc(14 * var(--u)) calc(18 * var(--u)); display: flex; flex-direction: column; gap: calc(4 * var(--u)); transition: border-color 0.35s ease; }
  .part li.skip { background: none; border-style: dashed; opacity: 0.6; }
  :global(.e1.rib) .part li.talk { border-color: var(--ink); }
  .ch { font-size: calc(38 * var(--u)); line-height: 1.15; }
  .where { font-size: calc(26 * var(--u)); color: var(--muted); }
  .half { margin-top: auto; border: calc(4 * var(--u)) solid var(--accent); color: var(--accent); padding: calc(16 * var(--u)) calc(20 * var(--u)); font-size: calc(34 * var(--u)); font-weight: 700; line-height: 1.2; }
  :global(.e1:not(.rib)) :global(.ribbon) { opacity: 0; pointer-events: none; }
</style>

<script>
  import { slide, type How } from '../../scripts/defence/deck';

  // Build 2: the ribbon appears, each of its four tiles flying in from its chapter's name on the map, a little after the
  // one before; the two half names fade in as they land. Stepping back or jumping just shows or hides it.
  const FLY = 900, STAGGER = 140;
  for (const s of document.querySelectorAll<HTMLElement>('.slide.e1')) {
    const tiles = Array.from(s.querySelectorAll<HTMLElement>('.ribbon .rch')), heads = Array.from(s.querySelectorAll<HTMLElement>('.ribbon .rh'));
    let flights: Animation[] = [];
    const land = () => { flights.forEach((a) => a.cancel()); flights = []; };
    slide(s, {
      set(b: number, how: How) {
        land();
        s.classList.toggle('rib', b >= 2);
        if (b < 2 || how !== 'next') return;
        tiles.forEach((t, k) => {
          const nm = s.querySelector<HTMLElement>(`.nm[data-ch="${t.dataset.ch}"]`)!, from = nm.getBoundingClientRect(), to = t.getBoundingClientRect();
          const cs = getComputedStyle(t), ox = parseFloat(cs.paddingLeft) + parseFloat(cs.borderLeftWidth), oy = parseFloat(cs.paddingTop) + parseFloat(cs.borderTopWidth);
          const k0 = parseFloat(getComputedStyle(nm).fontSize) / parseFloat(cs.fontSize);
          const start = `translate(${from.left - to.left - ox}px, ${from.top - to.top - oy}px) scale(${k0})`;
          flights.push(t.animate([{ transform: start, transformOrigin: `${ox}px ${oy}px` }, { transform: 'none', transformOrigin: `${ox}px ${oy}px` }],
            { duration: FLY, delay: k * STAGGER, easing: 'cubic-bezier(0.45, 0, 0.2, 1)', fill: 'backwards' }));
        });
        heads.forEach((h, k) => flights.push(h.animate([{ opacity: 0 }, { opacity: 0.8 }], { duration: 400, delay: FLY + (2 * k + 1) * STAGGER, fill: 'backwards' })));
      },
      leave() { land(); },
    });
  }
</script>

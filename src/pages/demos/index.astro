---
import Base from '../../layouts/Base.astro';
// Demos are pages under this folder; list them here.
const demos = [
  {
    href: '/demos/eca/',
    name: 'Cellular automata',
    blurb: 'Any of the 256 Wolfram rules on a row of cells, then the parity rule on a grid, where a smiley copies itself, and on networks, where one seed spreads from the best- or the worst-connected node. Built for the live part of my PhD defence, where the audience plays rule 90 with their fingers.',
    meta: 'PhD defence · interactive',
  },
  {
    href: '/demos/echoes/',
    name: 'Finding echoes',
    blurb: 'What a gravitational-wave echo from a not-quite-black-hole would look like, where it would come from, and how to dig one out of detector noise without knowing its shape. Four animations from my MSc thesis.',
    meta: 'MSc thesis · interactive',
  },
];
---
<Base title="Demos" description="Interactive demonstrations: cellular automata on rows, grids and networks, made for a live crowd, and gravitational-wave echoes from my MSc thesis." wide>
  <div class="measure">
    <h1>Demos</h1>
    <p>
      Small interactive pages that run entirely in the browser, made for talks and for playing. Each one
      works offline once loaded and can be presented fullscreen on a projector.
    </p>
  </div>
  <ul class="grid">
    {demos.map((x) => (
      <li class="card">
        <h3><a href={x.href}>{x.name}</a></h3>
        <p>{x.blurb}</p>
        <div class="links">
          <a href={x.href}>open</a>
          <span class="meta">{x.meta}</span>
        </div>
      </li>
    ))}
  </ul>
</Base>

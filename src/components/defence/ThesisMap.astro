---
// E1: the thesis map, the big version of the ribbon that runs along the bottom of every slide after it: four parts,
// their chapters, where each was published, the ones skipped tonight hollow (said out loud, not written). Then the two
// halves of the research question land on the two parts that answer them. The groundwater paper waits for the end.
import Slide from './Slide.astro';
import { PARTS } from '../../scripts/defence/ribbon';
const where: Record<number, string> = {
  2: 'CNSNS 2025', 3: '', 4: 'under review', 5: 'Physica D 2025', 6: 'Physica D 2025',
  7: 'ACRI 2024', 8: 'Springer 2025', 9: 'under review', 10: 'work in progress',
};
const half: Record<string, string> = { II: 'What links rule and behaviour?', IV: 'Can we put that link to use?' };
---
<Slide label="The thesis in one slide" builds={1} class="e1">
  <h2>The thesis in one slide</h2>
  <div class="parts">
    {PARTS.map((p) => (
      <section class:list={['part', p.chs.every((c) => c.skip) && 'skip']}>
        <p class="pn">Part {p.n}</p>
        <h3>{p.name}</h3>
        <ul>
          {p.chs.map((c) => <li class:list={[c.skip && 'skip']}><span class="ch"><b>{c.ch}</b> {c.name}</span>{where[c.ch] && <span class="where">{where[c.ch]}</span>}</li>)}
        </ul>
        {half[p.n] && <p class="half" data-b="1">{half[p.n]}</p>}
      </section>
    ))}
  </div>
  <p class="appx"><b>Appendix</b> the cover’s still lifes <span class="where">in preparation</span></p>
  <p slot="say">The thesis has four parts. Part I sets the stage: a taxonomy of the many kinds of cellular automata (<em>A comprehensive taxonomy of cellular automata</em>, CNSNS 2025) and the networks they can live on. Part II reads rules before running them: exact growth rates of defects for the simplest rules (under review, and too technical for tonight), and the two numbers and the synchronisers of <em>Essential metrics for Life on graphs</em> (Physica D 2025). Part III, skipped tonight, is about cellular automata and neural networks (ACRI 2024 and a Springer book chapter, 2025). Part IV uses rules as instruments in network science: which network is this (under review in Information Sciences, first author Lucas C. de Oliveira), and which node matters (unpublished, work in progress). An appendix explains the cover; its mathematics is being written up.</p>
  <p slot="say">The two halves of the research question fall on two parts: Part II asks what links a rule and its behaviour, Part IV puts that link to use. From here on, the map runs along the bottom of every slide.</p>
</Slide>

<style>
  .parts { display: grid; grid-template-columns: repeat(4, 1fr); gap: calc(32 * var(--u)); flex: 1; min-height: 0; }
  .part { border-top: calc(6 * var(--u)) solid var(--ink); padding-top: calc(20 * var(--u)); display: flex; flex-direction: column; gap: calc(16 * var(--u)); }
  .part.skip { border-top-style: dashed; border-top-color: var(--line); }
  .pn { font-size: calc(30 * var(--u)); font-weight: 700; color: var(--accent); }
  .part h3 { font-size: calc(40 * var(--u)); min-height: 2.4em; }
  .part ul { list-style: none; padding: 0; gap: calc(16 * var(--u)); }
  .part li { border: calc(3 * var(--u)) solid var(--line); background: var(--panel); padding: calc(14 * var(--u)) calc(18 * var(--u)); display: flex; flex-direction: column; gap: calc(4 * var(--u)); }
  .part li.skip { background: none; border-style: dashed; opacity: 0.6; }
  .ch { font-size: calc(38 * var(--u)); line-height: 1.15; }
  .where { font-size: calc(26 * var(--u)); color: var(--muted); }
  .half { margin-top: auto; border: calc(4 * var(--u)) solid var(--accent); color: var(--accent); padding: calc(16 * var(--u)) calc(20 * var(--u)); font-size: calc(34 * var(--u)); font-weight: 700; line-height: 1.2; }
  .appx { font-size: calc(30 * var(--u)); display: flex; gap: calc(16 * var(--u)); align-items: baseline; }
  .appx .where { font-size: calc(26 * var(--u)); }
</style>

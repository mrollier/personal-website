---
import Base from '../../layouts/Base.astro';
import Triptych from '../../components/Triptych.astro';
import CaFamilies from '../../components/CaFamilies.astro';
import NetZoo from '../../components/NetZoo.astro';
import LlnaRule from '../../components/LlnaRule.astro';
import LlnaRun from '../../components/LlnaRun.astro';
import Sensitivity from '../../components/Sensitivity.astro';
import RuleScatter from '../../components/RuleScatter.astro';
import PartitionTwin from '../../components/PartitionTwin.astro';
const built = new Set(['roadmap', 'families', 'networks', 'two-numbers']); // tabs with content; the rest show a placeholder
import { getCollection } from 'astro:content';
const pubs = await getCollection('publications');
const pub = (id: string) => pubs.find((p) => p.id === id)!.data;
const link = (id: string) => { const p = pub(id); return p.doi ? `https://doi.org/${p.doi}` : p.url; };
const papers: [string, string, string][] = [
  ['ca-taxonomy', 'review article', 'families'],
  ['life-on-graphs', 'research article', 'two-numbers'],
  ['cnn-classification', 'book chapter', 'cheating'],
  ['cnn-nonuniform', 'conference paper', 'cnn'],
  ['lyapunov-spectra', 'under review', 'defects'],
  ['shape-irregularity', 'under review, second author', 'jaggedness'],
  ['node-importance', 'in preparation', 'impact'],
];
const questions: [string, string, string][] = [
  ['defects', 'Defects', 'Flip one cell. For which rules can you say exactly where the flip will go, and how does the wiring set how fast it spreads?'],
  ['two-numbers', 'Two numbers', 'What has to be true for the Game of Life to make sense on a network, and how much do two numbers computed from the rule alone tell you about what it will do?'],
  ['synchronisation', 'Synchronisation', 'Out of a quarter of a million rules, can you pick the handful that make a whole network flash in step without trying them all, and where does the network let them down?'],
  ['cnn', 'CA as CNN', 'Can a neural network reproduce a cellular automaton exactly, with no learning at all, and is it any faster?'],
  ['cheating', 'Cheating CNN', 'When a neural network sorts automata by their behaviour, is it looking at the behaviour or reading the rule off the pixels?'],
  ['jaggedness', 'Jaggedness', 'What makes a rule good at telling networks apart, and can that steer the search for good rules?'],
  ['impact', 'Impact', 'If a network is heading for a unanimous vote, how few nodes do you need to nudge to flip the result, and are they the ones the textbooks call central?'],
];
// One tab per chapter of the thesis plus the cover; the hash picks the tab, so a chapter can be linked.
const tabs = [
  { id: 'roadmap', n: '1', name: 'Roadmap' },
  { id: 'families', n: '2', name: 'Families' },
  { id: 'networks', n: '3', name: 'Networks' },
  { id: 'defects', n: '4', name: 'Defects' },
  { id: 'two-numbers', n: '5', name: 'Two numbers' },
  { id: 'synchronisation', n: '6', name: 'Synchronisation' },
  { id: 'cnn', n: '7', name: 'CA as CNN' },
  { id: 'cheating', n: '8', name: 'Cheating CNN' },
  { id: 'jaggedness', n: '9', name: 'Jaggedness' },
  { id: 'impact', n: '10', name: 'Impact' },
  { id: 'answers', n: '11', name: 'Answers' },
  { id: 'cover', n: '', name: 'Cover' },
];
---
<Base title="The thesis, chapter by chapter" description="My PhD thesis on cellular automata and network automata as twelve interactive demos: one tab per chapter, each with the idea in plain words and a live simulation to play with." wide>
  <div class="measure">
    <h1>The thesis, chapter by chapter</h1>
    <p>
      My PhD thesis is called <em>The rich landscape of iterated simplicity: cellular automata and
      network automata</em>. The whole of it turns on one observation. Take a row, a grid or a network of
      cells, each on or off. Give every cell the same small rule about what to do next, based only on its
      neighbours. Apply the rule to all cells at once, over and over. What comes out is anything from
      dead calm to noise, with fractals, gliders, synchronised flashing and majority votes in between. The
      thesis asks how much of that landscape can be read off the rule before running it, how the wiring
      changes the answer, and what the whole thing has to do with neural networks.
    </p>
    <p>
      Each tab below is one chapter, told in plain words with a figure you can play with. The figures
      run in your browser, on a small scale; where the thesis needed a cluster, the number it found is
      quoted next to the live version. The thesis was a joint degree of Ghent University and the
      University of São Paulo, supervised by Jan Baetens and Odemir Bruno, with Aisling Daly as
      co-supervisor. The papers behind the chapters are on the <a href="/research/">research page</a>; a
      gentler first walk through cellular automata is the <a href="/demos/cellular-automata/">other demo</a>.
    </p>
  </div>

  <div class="tabbed">
    <nav class="tabs" aria-label="Chapters">
      <ul role="tablist" aria-orientation="vertical">
        {tabs.map((t, i) => <li><a role="tab" id={`tab-${t.id}`} href={`#${t.id}`} aria-controls={t.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.n && <small>{t.n}</small>}{t.name}</a></li>)}
      </ul>
    </nav>
    <div class="panels">

      <section role="tabpanel" id="roadmap" aria-labelledby="tab-roadmap" tabindex="0">
        <div class="measure">
          <h2>Roadmap</h2>
          <p>
            Two ants meeting is easy to describe; the colony's foraging is not. One neuron is tractable; a brain
            is not. The rules for elementary particles fit on a page, and out of them come weather, life and
            thought. Whether that kind of richness can come <em>purely</em> from simple rules applied over and
            over is an old argument in science, and this thesis adds a piece to it by studying the cleanest
            cases we have: cellular automata, and their cousins on networks.
          </p>
          <p>
            A <em>cellular automaton</em> is a grid of cells, each in one of a few states, where every cell
            updates at the same moment by one fixed rule that looks only at its neighbours. Even the smallest
            version, one row of on-or-off cells looking left and right, draws a remarkable variety of pictures,
            and Conway's Game of Life on a grid can host gliders, oscillators and, given patience, a computer.
            Real systems, though, are rarely wired as grids. Cells, people and proteins interact along sparse,
            uneven networks with hubs and shortcuts. Put the same rule on such a network and you have
            a <em>network automaton</em>, a much less studied object, and the thesis's home ground.
          </p>
        </div>
        <Triptych />
        <div class="measure">
          <p class="meta">
            One recipe, three substrates: rule 110 on a ring of cells (time runs down), the Game of Life on a
            torus, and the parity rule on a small-world network, all stepping together. Space plays and pauses
            once the figure has focus; → steps; f is fullscreen.
          </p>
          <h3>Three things the thesis sets out to do</h3>
          <ol>
            <li><strong>Get the mathematics in order.</strong> Sort the sprawling literature on cellular automata into a
              few families, say precisely what a Life-like rule means on a network, and work out by hand what can be
              worked out by hand. The recurring idea is a <em>genotype</em> and a <em>phenotype</em>: a few numbers read off
              the rule, and the behaviour the rule produces when run.</li>
            <li><strong>Separate the wiring from the rule.</strong> The picture an automaton draws depends on the network it
              lives on and on the rule it follows. Where the two can be told apart, ask exactly how the network's
              shape changes what the rule does.</li>
            <li><strong>Use these systems both ways.</strong> As objects to study, and as instruments: a rule run on an unknown
              network says something about that network. And as a bridge to machine learning, because a cellular
              automaton is a convolutional neural network with its weights written down by hand, and a network
              automaton is a message-passing network in the same way.</li>
          </ol>
          <h3>One question per chapter</h3>
          <ul class="questions">
            {questions.map(([id, name, q]) => <li><a href={`#${id}`}>{name}</a> {q}</li>)}
          </ul>
          <p>
            The two chapters before those, <a href="#families">Families</a> and <a href="#networks">Networks</a>, set up
            the vocabulary, and <a href="#answers">Answers</a> collects what came out. The <a href="#cover">Cover</a> tab is
            about the picture on the front.
          </p>
          <h3>The papers behind the chapters</h3>
          <ul class="papers">
            {papers.map(([id, kind, tab]) => <li>{link(id) ? <a href={link(id)}>{pub(id).title}</a> : pub(id).title}<span class="meta"> · {kind} · <a href={`#${tab}`}>{tabs.find((t) => t.id === tab)!.name}</a></span></li>)}
          </ul>
          <p class="meta">
            Joint PhD of Ghent University (Bioscience Engineering: Mathematical Modelling) and the University of São
            Paulo (Physics), 2026. Supervisors Jan M. Baetens and Odemir M. Bruno, co-supervisor Aisling J. Daly.
          </p>
        </div>
      </section>

      <section role="tabpanel" id="families" aria-labelledby="tab-families" tabindex="0" hidden>
        <div class="measure">
          <h2>Families</h2>
          <p>
            Here is the whole recipe once more, with the numbers in. A row of cells, each 0 or 1. Every cell
            looks at itself and its two neighbours, three cells, so eight possible views. A rule says what the
            cell becomes next for each of the eight, which makes 2<sup>8</sup> = 256 rules, numbered 0 to 255 by
            reading the eight answers as a binary number. Everyone updates at once, and the row is a ring. That is
            an <em>elementary</em> cellular automaton, and it is already enough for rule 110 to be a working
            computer, in principle. Two symmetries cut the 256 down to 88 genuinely different rules: look at a
            rule in a mirror, or swap the roles of 0 and 1, and you get a rule that draws the same pictures
            reflected or inverted. The readout under the figure names both relatives.
          </p>
          <p>
            Every research field that uses cellular automata bends one item of that recipe, and my review
            paper sorted the bends into five families. The figure starts as the plain thing and every control
            below it is one of the bends, so they can be mixed. Time runs down; once the picture is full it
            scrolls.
          </p>
        </div>
        <CaFamilies />
        <div class="measure">
          <p>
            <strong>Edges.</strong> A real simulation has a first and a last cell, and something has to stand in
            for the neighbour that is not there. The usual answer is to close the row into a ring. The other
            seven answers in the <em>boundary</em> menu fix the missing neighbour at a constant, copy the edge
            cell, mirror it, borrow a cell from elsewhere in the row, flip a coin every tick, or leave it
            undefined and simply stop updating the cells that would need it. The choice looks like a detail and
            is not: it decides whether information can leak in from the sides.
          </p>
          <p>
            <strong>Asynchronous.</strong> Nature has no central clock. Lower the <em>synchrony</em> α and each
            cell updates with that probability per tick, otherwise it waits. Rules that were tidy at α = 1 often
            fall apart at α = 0.9, and a few become tidier.
          </p>
          <p>
            <strong>Stochastic.</strong> Give each cell two rules, φ and a second rule ψ, and let it flip a
            weighted coin every tick to choose between them: that is <em>P(φ)</em>. With ψ = 204, the rule that
            leaves every cell as it is, this is exactly the asynchronous case. With two proper rules the row is
            a Markov chain, and as the weight moves the behaviour can change abruptly, a phase transition. Two
            rules that are each chaotic can even settle into a periodic pattern together.
          </p>
          <p>
            <strong>Non-uniform.</strong> Instead of a coin every tick, decide once which cells follow ψ and
            freeze that allocation. The <em>share on ψ</em> slider does it at random; a click on a column hands
            that column over, and the columns on ψ are tinted blue. The share is the degree of non-uniformity
            ν. The extreme case is one cell that does something different, and the <em>clamp</em> button makes
            the middle cell never change at all. That single stuck cell is the seed of the last chapter, where
            clamping one node tells us how much that node matters.
          </p>
          <p>
            <strong>Extended neighbourhood.</strong> Set the <em>radius</em> to 2 and each cell sees five cells
            instead of three, which makes 2<sup>32</sup>, over four billion, rules; the table is gone because it
            no longer fits on a page. Push this further and the neighbourhood need not be the cells next door
            at all, but whatever a cell is wired to. Then the row is a network, the rule has to treat all
            neighbours alike because they no longer come in an order, and you have a network automaton, which
            is what the rest of the thesis is about.
          </p>
          <p>
            <strong>Multi-state.</strong> Set <em>states</em> to 3 and the rule space explodes to 3<sup>27</sup>, so
            the figure keeps only the rules that look at the neighbourhood total, 3<sup>7</sup> = 2187 of them.
            Three states drawn in grey, black and blank. A two-rule non-uniform automaton, by the way, is
            secretly a four-state uniform one, which is one of the identities the review draws between the
            families.
          </p>
          <p>
            One number in the readout is worth knowing: λ, Langton's parameter, the share of the eight cases
            that give a 1. It is the simplest example of a <em>genotype</em>, something read off the rule table
            without running anything, and the thesis keeps asking how far such numbers predict
            the <em>phenotype</em>, the picture the rule actually draws.
          </p>
          <p>
            Things to try. Rule 30 with the boundary set to fixed and the edge cells at 0, from a single seed,
            then the same with adiabatic edges. Rule 110 at synchrony 0.95. Rule 90 with ψ = 150 at P(φ) = 0.5.
            Rule 30 with a third of the columns on ψ = 204. And the random rule button at radius 2, a few times.
          </p>
          <p class="meta status-line">
            Ch. 2 condenses <a href={link('ca-taxonomy')}>{pub('ca-taxonomy').title}</a>, {pub('ca-taxonomy').venue} ({pub('ca-taxonomy').year}), with Kallil Zielinski, Aisling Daly, Odemir Bruno and Jan Baetens.
          </p>
        </div>
      </section>

      <section role="tabpanel" id="networks" aria-labelledby="tab-networks" tabindex="0" hidden>
        <div class="measure">
          <h2>Networks</h2>
          <p>
            A network is a set of nodes and the links between them, nothing more: people and friendships,
            metabolites and reactions, atoms and bonds. The links are the whole story. Two nodes are
            neighbours if a link joins them, and a node's <em>degree</em> is how many links it has. What made
            networks a science in their own right, in the late 1990s, was the discovery that real ones are
            neither grids nor random tangles. Watts and Strogatz noticed that real networks are clustered like
            a grid, your friends know each other, and yet short like a random network, everyone is a few
            steps from everyone: the <em>small world</em>. Barabási and Albert noticed that many have a few
            enormous hubs and a long tail of poorly connected nodes, because new links prefer nodes that
            already have many.
          </p>
          <p>
            The thesis does not model any real network. It uses three families of synthetic ones as dials that
            run from grid-like to random and from all-nodes-alike to hub-dominated, and asks what a rule does
            along each dial. All three are in the figure. Colour the nodes by a centrality, click a node for its
            six values, and press the sweep to see how the small-world index moves with the rewiring.
          </p>
        </div>
        <NetZoo />
        <div class="measure">
          <p>
            <strong>A ring, rewired.</strong> Start with a ring where every node is linked to its k/2 nearest
            neighbours on each side, the wiring of a one-dimensional cellular automaton with a wider reach. Then
            visit each link and, with probability p, move one end to a random node. At p = 0 it is the ring; a
            few shortcuts make it a small world; at p = 1 it is as good as random. The shortcuts are drawn in
            blue. <strong>A grid, rewired.</strong> The same, starting from a torus with four, eight or twelve
            neighbours, exactly the three neighbourhoods a two-dimensional automaton uses. A signal has two
            dimensions to spread in before any rewiring, which matters later. <strong>Preferential
            attachment.</strong> Grow the network one node at a time; each newcomer links to m existing nodes,
            picking node i with probability proportional to k<sub>i</sub><sup>α</sup> + 1. At α = 0 everyone
            is equally attractive and there are no hubs. At α = 1 the rich get richer in proportion to their
            wealth, the classic Barabási–Albert model, and the degrees follow a power law. Above 1 a single hub
            grabs a large share of all links, and at α = 3 nearly all of them: not a more heterogeneous network,
            a different kind of network altogether.
          </p>
          <p>
            <strong>How small is small.</strong> The usual measure of small-worldness compares clustering with a
            random network, and by that yardstick almost everything is a small world. The thesis uses
            Telesford's index ω instead, which compares the path length with the random end of the dial and the
            clustering with the lattice end: ω near −1 means lattice-like, near +1 random-like, and the band
            between −½ and ½ is the small world. The sweep draws ω against p on a logarithmic axis, because that
            is where the action is. In the thesis the band sits between p ≈ 0.01 and 0.15 for rings and crosses
            zero near p ≈ 0.05; for grids it crosses near p ≈ 0.09. The point is that a grid of six evenly
            spaced p values, the kind of grid one naturally picks, misses the small-world regime entirely: at
            p = 0.2 a ring is already random-leaning, ω ≈ 0.65. So the thesis uses evenly spaced p where the
            gradual loss of local structure is the topic, and logarithmically spaced p where the small world
            is. One more trap: p is not the same amount of rewiring in the two families, since the ring routine
            moves both ends of a link and the grid routine one, so 2p − p² of the ring's links change against
            p of the grid's.
          </p>
          <p>
            <strong>Six ways of being central.</strong> Degree is the obvious one. Average neighbour degree asks
            how well connected your neighbours are, which turns out to be almost unrelated to your own degree.
            The h index is the largest h such that h of your neighbours have at least h links, a coarse but
            cheap blend of the two. Eigenvector centrality is recursive: you score high by being linked to
            nodes that score high. Betweenness counts how many shortest paths between other nodes run through
            you, the bridges. Closeness is how few steps it takes you to reach everyone. In the thesis's
            networks degree, the h index and eigenvector centrality move together, and the others each say
            something of their own; in the preferential-attachment family every one of them has a heavy tail.
            The last chapter asks which of the six, if any, predicts how much a node actually matters.
          </p>
          <p>
            <strong>What runs on them.</strong> Networks are substrates. Epidemics on hub-heavy networks have no
            threshold: the hubs keep the disease alive however weak it is. In the voter model a node copies a
            random neighbour, and a <em>zealot</em> that never changes its mind can tilt the outcome, which is
            the idea behind the clamped node of the last chapter. In threshold models a node flips once enough
            of its neighbours have, and the Life-like rules of the next chapters are threshold rules with the
            threshold replaced by an arbitrary pattern. And a <em>network automaton</em> is what you get when
            every node runs the same deterministic rule on its neighbours' states at once. Because nodes have
            no natural order and different degrees, the rule may only count: how many neighbours are on, or
            what share of them. Rules of that kind are called <em>outer-totalistic</em>, and the whole of this
            thesis lives there.
          </p>
          <p>
            Things to try. Ring, degree 8, drag p up from 0 with the log scale on and watch ⟨l⟩ collapse long
            before ⟨C⟩ moves. Grid with four neighbours: no triangles, so ω is undefined. Preferential attachment
            at α = 0, 1 and 3 with the colour set to degree, then to average neighbour degree, and look at who
            is dark. Click the hub and then one of its leaves.
          </p>
          <p class="meta status-line">
            Ch. 3 is background; it introduces the networks and the measures the later chapters use. The
            thesis generated them with igraph; the figure regenerates them in the browser at a smaller size.
          </p>
        </div>
      </section>

      <section role="tabpanel" id="two-numbers" aria-labelledby="tab-two-numbers" tabindex="0" hidden>
        <div class="measure">
          <h2>Two numbers</h2>
          <p>
            From here on the thesis lives on networks, and the rule it runs is the Game of Life stretched to
            fit. Life's rule counts neighbours: born with exactly three, survive with two or three. On a network
            one node has two neighbours and the next has twenty, so counting will not do. Count the <em>share</em>
            instead: ρ, the fraction of a node's neighbours that are on, a number between 0 and 1. Cut the unit
            interval into r equal pieces and let the rule say, for each piece, whether a dead node is born there
            and whether a live node survives there. Two sets of pieces, <em>born</em> B and <em>survive</em> S,
            written as the binary numbers β and σ, and the rule is φ<sup>r</sup><sub>β,σ</sub>. With r = 9 on a grid of
            eight neighbours the nine pieces are the nine possible counts and Life is back as φ<sup>9</sup><sub>8,12</sub>.
            We called the family <em>Life-like network automata</em>; there are 2<sup>2r</sup> rules at each r.
          </p>
          <p>
            The first job of the chapter was to make that definition consistent, and the trap is at the edges of
            the pieces. Swapping every on for off is a symmetry cellular automata have always had, and to keep it
            on a network the cut of the density axis has to mirror round ½: below the middle a piece includes its
            left end, above the middle its right end, the middle piece is closed at both ends, and r has to be odd
            for there to be a middle piece. With that cut, every rule has an <em>equivalent</em> rule that does the
            same thing with the colours swapped, and 2<sup>r</sup> rules are their own equivalent. Earlier work
            used the obvious cut, every piece closed on the left, and the symmetry quietly breaks whenever a
            density lands exactly on a boundary, which on a network with small degrees happens all the time. The
            last figure on this tab shows the break happening.
          </p>
          <p>
            The diagram below is the rule, and its mean-field curve is the first of the two numbers: at ρ = ½
            the curve's height is the <em>Hamming weight</em>, the share of all inputs that give a live node. It is
            the same diagram as on the <a href="/demos/cellular-automata/#life-on-graphs">other demo</a>, where the
            curve is explained at more length.
          </p>
        </div>
        <LlnaRule />
        <div class="measure">
          <p>
            The second number is the <em>Boolean sensitivity</em>: pick a random input, flip one of its k + 1
            bits, the node's own state or one neighbour's, and count how often the outcome changes, averaged over
            everything. It splits in two on the diagram. <em>Identity sensitivity</em> counts the pieces filled in
            only one of the two rows, where the node's own state decides; <em>neighbourhood sensitivity</em>
            counts how often a row changes colour between one reachable density and the next, the jaggedness of
            the picture. Both are tinted and marked in the figure. The sensitivity is also the slope at the origin
            of the <em>Derrida curve</em>: take two copies of a random configuration that differ in a share δ of
            the nodes, run both one tick, and ask what share differs now. A slope above 1 means a small
            difference grows, below 1 it dies. And it is the expected number of ones in a row of the Jacobian of
            the previous chapter, which is why the two chapters belong together. Neither number needs a
            simulation; both need only the rule and the degree.
          </p>
          <p>
            The degree matters more than one would think. Slide k and watch the marks move: a node with four
            neighbours can only see the densities 0, ¼, ½, ¾ and 1, so it skips half the pieces of a nine-piece
            rule, and a node with twenty-four sees almost only the middle piece. On a network with a spread of
            degrees the honest numbers are the averages over that spread, which the bars on the right show for
            four kinds of network; for the hub-heavy family it makes a visible difference.
          </p>
        </div>
        <Sensitivity />
        <div class="measure">
          <p>
            The two numbers are not independent. Every flip that changes the outcome joins an input that gives 1
            to one that gives 0, so a rule with few 1s cannot be very sensitive: BS ≤ 2(k + 1)·min(HW, 1 − HW),
            a tent with its top at HW = ½, where the parity rule sits with every flip counting. Below is every
            rule of one resolution as a dot under that tent. Click one and it lands in the figure above.
          </p>
        </div>
        <RuleScatter />
        <div class="measure">
          <p>
            So much for the genotype. The phenotype is what the rule does when run, and the chapter measured two
            time series to match the two numbers: the share of nodes that are on, and the share that differs
            between two runs started one node apart. The rule below, Morley, φ<sup>9</sup><sub>328,52</sub>, shows
            how much the network has to say about both: on the grid it converges gradually, on a rewired grid
            suddenly, and on a random network sometimes not at all, with sharp transitions in between as the
            start density or the rewiring changes. The thesis then ran all 528 non-equivalent rules of resolution
            5 on 900-node grids, plain, rewired and random, 900 samples each, and correlated genotype with
            phenotype: the Hamming weight predicts the final share on with R = 0.70 to 0.73, the sensitivity
            predicts the final share differing with R = 0.54 to 0.55. Good enough to throw away most of a rule
            space without running it; not good enough to skip running the rest. That is the sentence the next
            chapters lean on.
          </p>
        </div>
        <LlnaRun mode="defect" preset="morley" />
        <div class="measure">
          <p>
            One last figure, for the appendix on the symmetry. Below, a rule and its equivalent run side by side
            on the same random network, one from a random start and the other from the exact negative of that
            start. Under the thesis's mirrored cut of the density axis the two runs stay negatives of each other
            for ever, and the red rings never appear. Switch to the older uniform cut and the rings appear on the
            first tick at nodes whose degree is a multiple of five, where a density sits exactly on a boundary
            and the two cuts disagree; from there the difference spreads. The readout works through the bit
            arithmetic: mirror the survive set, toggle it, and you have the born set of the equivalent rule.
          </p>
        </div>
        <PartitionTwin />
        <div class="measure">
          <p>
            Things to try. HighLife at k = 4 and at k = 12 in the sensitivity figure: same rule, different
            numbers. The parity preset from the other page, φ<sup>3</sup><sub>2,5</sub>, at resolution 3: the
            sensitivity is k + 1 at every degree the pieces can resolve. In the scatter, resolution 7 at degree 6,
            and hunt for the corners of the tent. In the Morley figure, the lattice at 50% on, then 75%, then the
            same on the random network.
          </p>
          <p class="meta status-line">
            Ch. 5 is the first half of <a href={link('life-on-graphs')}>{pub('life-on-graphs').title}</a>, {pub('life-on-graphs').venue} ({pub('life-on-graphs').year}), with Lucas de Oliveira, Odemir Bruno and Jan Baetens; code at <a href="https://github.com/mrollier/essential-metrics-life-on-graphs">GitHub</a>.
          </p>
        </div>
      </section>

      {tabs.filter((t) => !built.has(t.id)).map((t) => (
        <section role="tabpanel" id={t.id} aria-labelledby={`tab-${t.id}`} tabindex="0" hidden>
          <div class="measure">
            <h2>{t.name}</h2>
            <p class="meta">This chapter's demo is on its way.</p>
          </div>
        </section>
      ))}

    </div>
  </div>
</Base>

<style>
  .tabbed { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0 2rem; align-items: start; margin-top: 1.5rem; }
  .tabs { position: sticky; top: 1rem; min-width: 0; }
  .tabs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.15rem; border-left: 1px solid var(--line); }
  .tabs a {
    display: block; padding: 0.3rem 0.8rem; margin-left: -1px; border-left: 2px solid transparent;
    color: var(--muted); text-decoration: none; font-size: 0.95rem;
  }
  .tabs small { display: inline-block; width: 1.5em; font-family: var(--mono); font-size: 0.75em; color: var(--muted); }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-selected="true"] { color: var(--ink); border-left-color: var(--accent); font-weight: 600; }
  .panels { min-width: 0; }
  [role="tabpanel"]:focus { outline: none; }
  [role="tabpanel"] > .measure > h2:first-child { margin-top: 0; }
  .formula { font-family: var(--mono); font-size: 0.9rem; padding: 0.5rem 0.8rem; border-left: 2px solid var(--line); }
  .questions, .papers { padding-left: 1.2rem; }
  .questions li, .papers li { margin-bottom: 0.5rem; }
  .questions a { font-weight: 600; }
  .status-line { margin-top: 2rem; padding-top: 0.8rem; border-top: 1px solid var(--line); }
  @media (max-width: 800px) {
    .tabbed { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .tabs { top: 0; z-index: 5; background: var(--bg); padding: 0.4rem 0; }
    .tabs ul { flex-direction: row; overflow-x: auto; border-left: 0; border-bottom: 1px solid var(--line); gap: 0; }
    .tabs a { white-space: nowrap; margin: 0 0 -1px; border-left: 0; border-bottom: 2px solid transparent; padding: 0.3rem 0.7rem; }
    .tabs small { width: auto; margin-right: 0.3em; }
    .tabs a[aria-selected="true"] { border-bottom-color: var(--accent); }
  }
</style>

<script>
  // The hash picks the tab: a tab's own id, or the id of anything inside a tab. Arrow keys walk the list.
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[role="tab"]'));
  const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
  const box = document.querySelector<HTMLElement>('.tabbed')!;

  function show(id: string, scroll: boolean) {
    let i = tabs.findIndex((t) => t.getAttribute('aria-controls') === id), target: HTMLElement | null = null;
    if (i < 0) { target = id ? document.getElementById(id) : null; const p = target?.closest<HTMLElement>('[role="tabpanel"]'); i = p ? panels.indexOf(p) : 0; }
    if (i < 0) i = 0;
    tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; panels[k].hidden = k !== i; });
    // an anchor inside a tab scrolls to it; a tab change only scrolls back up when the reader was deep in the previous one
    if (target) target.scrollIntoView({ block: 'start' });
    else if (scroll && scrollY > box.offsetTop) box.scrollIntoView({ block: 'start' });
  }
  const fromHash = () => show(decodeURIComponent(location.hash.slice(1)), true);
  addEventListener('hashchange', fromHash);
  fromHash();

  document.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key, i = tabs.indexOf(document.activeElement as HTMLAnchorElement);
    if (i < 0) return;
    const n = tabs.length, j = k === 'ArrowDown' || k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowUp' || k === 'ArrowLeft' ? (i + n - 1) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1;
    if (j < 0) return;
    e.preventDefault(); location.hash = tabs[j].getAttribute('aria-controls')!; tabs[j].focus();
  });
</script>

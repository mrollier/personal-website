---
// Covers in a Strip: records (square), books or films (portrait). Each cell links out; details sit in the caption and title.
import Strip from './Strip.astro';
type Item = {
  id: string; url: string; cover: string | null; w?: number; h?: number; title: string;
  artist?: string; label?: string; catno?: string; year?: number; format?: string; // records
  author?: string; rating?: number; shelves?: string[]; published?: number;         // books
  watched?: string; rewatch?: boolean;                                              // films
};
const { items, kind, label } = Astro.props as { items: Item[]; kind: 'records' | 'books' | 'films'; label: string };
const head = (x: Item) => (kind === 'records' ? x.artist! : x.title);
const sub = (x: Item) => (kind === 'records' ? x.title : kind === 'books' ? x.author! : String(x.year ?? ''));
const detail = (x: Item) =>
  kind === 'records'
    ? [`${x.artist} – ${x.title}`, [x.label, x.catno].filter(Boolean).join(' '), x.year, x.format].filter(Boolean).join(' · ')
    : kind === 'books'
      ? [`${x.title} – ${x.author}`, x.published, x.rating ? `${x.rating}/5` : ''].filter(Boolean).join(' · ')
      : [`${x.title} (${x.year})`, x.watched && `watched ${x.watched}${x.rewatch ? ' again' : ''}`, x.rating ? `${x.rating}/5` : ''].filter(Boolean).join(' · ');
// Ratings: whole stars, a half for films, the rest greyed.
const stars = (r: number) => ({ full: Math.floor(r), half: r % 1 >= 0.5, empty: 5 - Math.ceil(r) });
---
<Strip kind={kind} label={label} count={items.length}>
  {items.map((x) => {
    const s = x.rating ? stars(x.rating) : null;
    return (
      <li data-shelves={kind === 'books' ? (x.shelves ?? []).join(' ') : undefined}>
        <a href={x.url} title={detail(x)} tabindex="-1">
          {x.cover ? (
            <img src={x.cover} alt={`${head(x)} – ${sub(x)}`} width={x.w} height={x.h} loading="lazy" decoding="async" />
          ) : (
            <span class="nocover" aria-hidden="true"></span>
          )}
        </a>
        <span class="cap">
          <b>{head(x)}</b>
          <span>{sub(x)}</span>
          {s && (
            <span class="stars" aria-label={`${x.rating} out of 5`}>{'★'.repeat(s.full)}{s.half && '½'}<i>{'★'.repeat(s.empty)}</i></span>
          )}
        </span>
      </li>
    );
  })}
</Strip>

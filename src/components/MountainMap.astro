---
type Pt = { name: string; lat: number; lon: number };
const { points } = Astro.props as { points: Pt[] };
const P = 1.5;
const lons = points.map((p) => p.lon), lats = points.map((p) => p.lat);
const x0 = Math.min(...lons) - P, x1 = Math.max(...lons) + P;
const y0 = Math.min(...lats) - P, y1 = Math.max(...lats) + P;
const X = (lon: number) => ((lon - x0) / (x1 - x0)) * 600;
const Y = (lat: number) => ((y1 - lat) / (y1 - y0)) * 300;
---
{points.length > 0 && (
  <svg class="map" viewBox="0 0 600 300" role="img" aria-label={`Map of ${points.length} summits`}>
    {points.map((p) => (
      <>
        <rect x={X(p.lon) - 3} y={Y(p.lat) - 3} width="6" height="6" fill="var(--accent)" />
        <text x={X(p.lon) + 6} y={Y(p.lat) - 5} font-size="9" font-family="var(--mono)" fill="currentColor">{p.name}</text>
      </>
    ))}
  </svg>
)}

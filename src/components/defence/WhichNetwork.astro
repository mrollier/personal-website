---
// G1–G3: the stadium game (classify a network by the pattern one rule draws on it), fingerprints on toy networks
// (Lempel–Ziv complexity and word entropy of every person's row, then the density histogram Ch. 9 used), and why a
// consensus-seeking rule is a bad detective where a jagged rule is a good one, which leads to what consensus-seeking
// rules are good for instead. Toy data from src/data/defence/classify.json (scripts/defence/precompute.ts).
import Slide from './Slide.astro';
import Phi from './Phi.astro';
import classify from '../../data/defence/classify.json';
const [cons, det] = classify.examples;
const types = classify.params.types;
const boxes = ['network', 'run one rule', 'pattern: who is up when', 'statistics: histograms', 'simple classifier'];
const rows = [
  { f: 'lz', b: 1, name: 'Lempel–Ziv complexity', say: 'how hard each person’s row is to compress' },
  { f: 'we', b: 2, name: 'word entropy', say: 'how varied the stretches with a hand up are' },
  { f: 'density', b: 3, name: 'share of contacts up', say: 'what each person sees; Chapter 9 used this, per number of contacts' },
];
---
<Slide label="The stadium game" class="g1">
  <h2>Which network is this?</h2>
  <p class="lede">The same instructions, the stadium wave, in different stadiums: can you tell the stadium from the wave?</p>
  <div class="pipe">
    {boxes.map((b, i) => (
      <>
        <div class="box"><svg viewBox="0 0 120 90" aria-hidden="true" data-glyph={i}></svg><span>{b}</span></div>
        <span class="arrow" aria-hidden="true">→</span>
      </>
    ))}
    <div class="box out"><span>network type</span></div>
  </div>
  <p class="cite">Pipeline: G. H. B. Miranda et al. 2016; J. Ribas et al. 2020; K. M. C. Zielinski et al. 2024 · Chapter 9: L. C. de Oliveira, M. Rollier, J. M. Baetens, O. M. Bruno (under review)</p>
</Slide>

<Slide label="Fingerprints" builds={3} class="g2">
  <h2>Fingerprints</h2>
  <div class="g2-grid">
    <p class="g2-row g2-tep"><b>who has a hand up</b><span>people ↓, rounds →</span></p>
    {types.map((ty, c) => (
      <figure data-type={c} style={`grid-column: ${c + 2}`}>
        <figcaption class="mono" data-t={c}>{ty.name}</figcaption>
        <canvas class="tep" aria-label={`who has a hand up on a ${ty.name} network: people down the side, rounds across`}></canvas>
        {rows.map((r) => <canvas class="hist" data-f={r.f} data-b={r.b} aria-label={`histogram of ${r.name} on the ${ty.name} network`}></canvas>)}
      </figure>
    ))}
    {rows.map((r, k) => <p class="g2-row" data-b={r.b} style={`grid-row: ${k + 3}`}><b>{r.name}</b><span>{r.say}</span></p>)}
  </div>
  <p class="cite">One rule, <Phi r={5} b={det.B} s={det.S} />, on networks of 200 people with 8 contacts on average · pattern: 50 of them, most contacts on top · histograms: all 200, rounds 10–99 · first two features after G. H. B. Miranda et al. 2016</p>
  <p class="illus">illustration: toy networks; the thesis used 23 datasets</p>
</Slide>

<Slide label="Some rules are better detectives" builds={3} class="g3">
  <h2>Some rules are better detectives</h2>
  <div class="g3-two">
    {[cons, det].map((x, i) => (
      <figure class="side" data-rule={i} data-b={i === 1 ? '1' : undefined}>
        <p class="g3-name">{i === 0 ? 'a consensus-seeking rule' : 'a jagged rule'} <Phi r={x.r} b={x.B} s={x.S} /> <span class="muted">· J̄ = {x.jbar.toFixed(2)}</span></p>
        <canvas class="diag" aria-label="the rule: when to raise a hand and when to keep it, for every share of contacts up"></canvas>
        <div class="minis">
          {types.map((ty, c) => <div class="mini"><canvas aria-label={`the pattern on a ${ty.name} network`}></canvas><span class="mono" data-t={c}>{ty.name}</span></div>)}
        </div>
        <canvas class="fp" aria-label="the Lempel–Ziv fingerprints of fifteen networks, five of each kind"></canvas>
        <p class="verdict">{i === 0 ? 'Everyone ends up agreeing: the rows go flat, the fingerprints crowd together.' : 'Rich patterns that “feel” the network: three different fingerprints.'}</p>
      </figure>
    ))}
  </div>
  <div class="stack g3-foot">
    <p class="result" data-b="2" data-b-off="3">Chapter 9, 23 datasets: in 13 of them, more jagged rules classify somewhat better (r ≈ 0.2–0.46), and the best rules sit at J̄ ≈ 0.5–0.9. Searching by jaggedness finds a rule within 5% of the best while trying only 10–20% of the rules.</p>
    <p class="bridge" data-b="3">Consensus-seeking rules make bad detectives. But they are good at something else: <b>finding who matters</b>.</p>
  </div>
  <p class="cite">fingerprints: Lempel–Ziv histograms of fifteen networks, five of each kind (thin), and each kind’s average (thick) · patterns: 50 people, the first 50 rounds</p>
  <p class="illus">illustration: toy networks, not a thesis figure</p>
</Slide>

<style>
  .pipe { display: flex; align-items: center; justify-content: center; gap: calc(12 * var(--u)); flex: 1; }
  .box { width: calc(250 * var(--u)); height: calc(250 * var(--u)); border: calc(3 * var(--u)) solid var(--line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: calc(14 * var(--u)); text-align: center; font-size: calc(32 * var(--u)); padding: calc(14 * var(--u)); background: var(--panel); }
  .box svg { width: calc(140 * var(--u)); }
  .box.out { border-color: var(--accent); color: var(--accent); font-weight: 600; width: calc(200 * var(--u)); }
  .arrow { font-size: calc(46 * var(--u)); color: var(--muted); }

  [data-t="0"] { color: #3e679e; } [data-t="1"] { color: var(--danger); } [data-t="2"] { color: var(--ink); }

  .g2-grid { display: grid; grid-template-columns: calc(330 * var(--u)) repeat(3, 1fr); grid-template-rows: calc(44 * var(--u)) calc(210 * var(--u)) repeat(3, calc(150 * var(--u))); gap: calc(16 * var(--u)) calc(40 * var(--u)); }
  .g2-grid figure { margin: 0; grid-row: 1 / span 5; display: grid; grid-template-rows: subgrid; justify-items: center; }
  .g2-grid figcaption { font-size: calc(32 * var(--u)); }
  .tep { width: calc(420 * var(--u)); height: calc(210 * var(--u)); }
  .hist { width: calc(420 * var(--u)); height: calc(150 * var(--u)); }
  .g2-row { grid-column: 1; display: flex; flex-direction: column; justify-content: center; gap: calc(6 * var(--u)); font-size: calc(30 * var(--u)); line-height: 1.2; }
  .g2-row span { font-size: calc(24 * var(--u)); color: var(--muted); }
  .g2-tep { grid-row: 2; }

  .g3-two { display: grid; grid-template-columns: 1fr 1fr; gap: calc(70 * var(--u)); }
  .side { margin: 0; display: flex; flex-direction: column; align-items: center; gap: calc(10 * var(--u)); }
  .g3-name { font-size: calc(34 * var(--u)); font-weight: 600; }
  .g3-name .muted { font-weight: 400; }
  .diag { width: calc(640 * var(--u)); height: calc(96 * var(--u)); }
  .minis { display: flex; gap: calc(26 * var(--u)); }
  .mini { display: flex; flex-direction: column; align-items: center; gap: calc(4 * var(--u)); font-size: calc(22 * var(--u)); }
  .mini canvas { width: calc(200 * var(--u)); height: calc(200 * var(--u)); }
  .fp { width: calc(760 * var(--u)); height: calc(190 * var(--u)); }
  .verdict { font-size: calc(30 * var(--u)); color: var(--accent); font-weight: 600; text-align: center; max-width: calc(760 * var(--u)); }
  .g3-foot { margin-top: auto; margin-bottom: calc(34 * var(--u)); }
  .result, .bridge { font-size: calc(30 * var(--u)); line-height: 1.3; background: var(--panel); padding: calc(14 * var(--u)) calc(22 * var(--u)); }
  .bridge { font-size: calc(40 * var(--u)); border-left: calc(8 * var(--u)) solid var(--accent); align-self: center; }
</style>

<script>
  import { stage, onSize, type Stage } from '../../scripts/defence/stage';
  import { label, pattern, px, py, type Plot } from '../../scripts/defence/plot';
  import { TOY, FEATURES, toyNet, toyRun, startSeed } from '../../scripts/defence/toy';
  import { type Rule } from '../../scripts/llna';
  import classify from '../../data/defence/classify.json';

  const TYPE = (t: { ink: string; danger: string }, c: number) => ['#3e679e', t.danger, t.ink][c];
  const [cons, det] = classify.examples;
  const ruleOf = (x: typeof det): Rule => ({ r: x.r, B: x.B, S: x.S, part: x.part as 'uni' | 'pal' });
  const RANGE = { lz: FEATURES.lz, we: FEATURES.we, density: { lo: 0, hi: 1, bins: TOY.bins } };
  type Feat = keyof typeof RANGE;

  // ── G1: little pictures in the pipeline boxes (square cells in the pattern, as everywhere) ──
  const glyphs = [
    '<g stroke="currentColor" stroke-width="3" fill="none"><path d="M20 20 L60 45 L100 25 M60 45 L40 75 L90 70 L60 45 M20 20 L40 75"/></g><g fill="currentColor"><circle cx="20" cy="20" r="7"/><circle cx="60" cy="45" r="7"/><circle cx="100" cy="25" r="7"/><circle cx="40" cy="75" r="7"/><circle cx="90" cy="70" r="7"/></g>',
    '<g fill="var(--panel)" stroke="var(--line)" stroke-width="2"><rect x="10" y="24" width="20" height="20"/><rect x="30" y="24" width="20" height="20" fill="var(--accent)"/><rect x="50" y="24" width="20" height="20"/><rect x="70" y="24" width="20" height="20" fill="var(--accent)"/><rect x="90" y="24" width="20" height="20"/><rect x="10" y="48" width="20" height="20" fill="var(--ink)"/><rect x="30" y="48" width="20" height="20"/><rect x="50" y="48" width="20" height="20" fill="var(--ink)"/><rect x="70" y="48" width="20" height="20" fill="var(--ink)"/><rect x="90" y="48" width="20" height="20"/></g>',
    Array.from({ length: 84 }, (_, k) => { const x = k % 12, y = Math.floor(k / 12); return ((x * 7 + y * 3 + x * y) % 5 < 2) ? `<rect x="${6 + x * 9}" y="${13 + y * 9}" width="8" height="8" fill="currentColor"/>` : ''; }).join(''),
    [18, 34, 52, 30, 16, 8].map((h, k) => `<rect x="${12 + k * 17}" y="${80 - h}" width="14" height="${h}" fill="var(--accent)"/>`).join('') + '<path d="M6 80 H114" stroke="currentColor" stroke-width="2"/>',
    '<g stroke="currentColor" stroke-width="3" fill="none"><path d="M10 70 L110 20"/></g><g fill="var(--accent)"><circle cx="30" cy="30" r="6"/><circle cx="42" cy="22" r="6"/><circle cx="24" cy="44" r="6"/></g><g fill="currentColor"><rect x="80" y="55" width="11" height="11"/><rect x="94" y="64" width="11" height="11"/><rect x="72" y="70" width="11" height="11"/></g>',
  ];
  document.querySelectorAll<SVGSVGElement>('.slide.g1 svg[data-glyph]').forEach((s) => { s.innerHTML = glyphs[+s.dataset.glyph!]; });

  /** People down (a sample of `rows` of them, most contacts first), rounds across: one square per person and round. */
  const people = (st: Stage, net: ReturnType<typeof toyNet>, s: Uint8Array, rows: number, rounds: number) => pattern(st, net.order, rows, rounds, (t, i) => !!s[t * net.n + i]);

  /** A histogram as bars (one fingerprint) or as step lines (many, faint, with each kind's average drawn thick), with the
   * ends of its range below. */
  function histPlot(st: Stage, f: Feat, hs: number[][], colors: string[], top: number, bars: boolean) {
    const { lo, hi, bins } = RANGE[f], p: Plot = { x: 4, y: 6, w: st.w - 8, h: st.h - 40, x0: lo, x1: hi, y0: 0, y1: top }, { ctx, t } = st, bw = p.w / bins;
    const steps = (h: number[]) => { ctx.beginPath(); h.forEach((v, b) => { const x = p.x + b * bw, y = py(p, v); if (b) ctx.lineTo(x, y); else ctx.moveTo(x, y); ctx.lineTo(x + bw, y); }); ctx.stroke(); };
    if (bars) hs.forEach((h, k) => { ctx.fillStyle = colors[k]; h.forEach((v, b) => ctx.fillRect(p.x + b * bw + 1.5, py(p, v), bw - 3, py(p, 0) - py(p, v))); });
    else {
      ctx.lineJoin = 'round'; ctx.lineWidth = 2; ctx.globalAlpha = 0.35;
      hs.forEach((h, k) => { ctx.strokeStyle = colors[k]; steps(h); });
      ctx.globalAlpha = 1; ctx.lineWidth = 6;
      for (const col of new Set(colors)) { const own = hs.filter((_, k) => colors[k] === col); ctx.strokeStyle = col; steps(own[0].map((_, b) => own.reduce((acc, h) => acc + h[b], 0) / own.length)); }
    }
    ctx.strokeStyle = t.muted; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(p.x, py(p, 0)); ctx.lineTo(p.x + p.w, py(p, 0)); ctx.stroke();
    label(st, String(lo), px(p, lo), st.h - 14, { size: 22, mono: true, color: t.muted });
    label(st, String(hi), px(p, hi), st.h - 14, { size: 22, mono: true, align: 'right', color: t.muted });
  }

  // ── G2: one network of each type: its pattern, then its three fingerprints, one per click ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.g2')) {
    const figs = Array.from(s.querySelectorAll<HTMLElement>('figure[data-type]')).map((el) => {
      const c = +el.dataset.type!;
      return { c, tep: el.querySelector<HTMLCanvasElement>('canvas.tep')!, hists: Array.from(el.querySelectorAll<HTMLCanvasElement>('canvas.hist')) };
    });
    // the runs are made the first time the slide is drawn, not at page load
    let runs: { net: ReturnType<typeof toyNet>; s: Uint8Array }[] | null = null;
    const runsOf = () => (runs ??= figs.map(({ c }) => { const net = toyNet(c, 0); return { net, s: toyRun(net, ruleOf(det), startSeed(c, 0)).s }; }));
    const shown = (f: Feat) => figs.map(({ c }) => det[f][c * TOY.perType]);
    const tops = Object.fromEntries((Object.keys(RANGE) as Feat[]).map((f) => [f, Math.max(...shown(f).flat()) * 1.08])) as Record<Feat, number>;
    for (const g of figs) {
      onSize(g.tep, () => { const st = stage(g.tep); if (st) people(st, runsOf()[g.c].net, runsOf()[g.c].s, 50, TOY.T); });
      for (const h of g.hists) onSize(h, () => { const st = stage(h), f = h.dataset.f as Feat; if (st) histPlot(st, f, [det[f][g.c * TOY.perType]], [TYPE(st.t, g.c)], tops[f], true); });
    }
  }

  // ── G3: the consensus-seeking rule and the jagged rule: the rule, three patterns, fifteen fingerprints ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.g3')) {
    s.querySelectorAll<HTMLElement>('figure[data-rule]').forEach((fig) => {
      const x = [cons, det][+fig.dataset.rule!], rule = ruleOf(x);
      const diag = fig.querySelector<HTMLCanvasElement>('canvas.diag')!, fp = fig.querySelector<HTMLCanvasElement>('canvas.fp')!;
      onSize(diag, () => {
        const st = stage(diag); if (!st) return;
        const { ctx, t } = st, left = 110, w = (st.w - left) / x.r, h = (st.h - 8) / 2;
        label(st, 'raise', left - 12, h / 2, { size: 24, align: 'right', color: t.muted }); label(st, 'keep', left - 12, 8 + 1.5 * h, { size: 24, align: 'right', color: t.muted });
        for (let i = 0; i < x.r; i++) for (const [row, mask, col] of [[0, x.B, t.accent], [1, x.S, t.ink]] as const) {
          const on = (mask >> i) & 1, X = left + i * w, Y = row * (h + 8);
          ctx.fillStyle = on ? col : t.panel; ctx.fillRect(X + 2, Y, w - 4, h);
          if (!on) { ctx.strokeStyle = t.line; ctx.lineWidth = 2; ctx.strokeRect(X + 3, Y + 1, w - 6, h - 2); }
        }
      });
      let runs: { net: ReturnType<typeof toyNet>; s: Uint8Array }[] | null = null;
      const runsOf = () => (runs ??= [0, 1, 2].map((c) => { const net = toyNet(c, 0); return { net, s: toyRun(net, rule, startSeed(c, 0)).s }; }));
      fig.querySelectorAll<HTMLCanvasElement>('.mini canvas').forEach((m, c) => onSize(m, () => { const st = stage(m); if (st) people(st, runsOf()[c].net, runsOf()[c].s, 50, 50); }));
      onSize(fp, () => {
        const st = stage(fp); if (!st) return;
        histPlot(st, 'lz', x.lz, x.lz.map((_, k) => TYPE(st.t, Math.floor(k / TOY.perType))), Math.max(...x.lz.flat()) * 1.05, false);
        label(st, 'Lempel–Ziv complexity', st.w / 2, st.h - 14, { size: 22, align: 'center', color: st.t.muted });
      });
    });
  }
</script>

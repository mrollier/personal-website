---
// F1–F4: from neighbours in a row to contacts anywhere in the room, the Game of Life as a rule on shares, and the two
// numbers that read a rule before it runs: the Hamming weight (with the mean-field curve) and the Boolean sensitivity
// (with the Derrida curve and a twin run where one person differs).
import Slide from './Slide.astro';
import Seats from './Seats.astro';
import Phi from './Phi.astro';
const B = 8, S = 12, r = 9;
const cells = Array.from({ length: r }, (_, i) => ({ b: (B >> i) & 1, s: (S >> i) & 1 }));
const cw = 1160 / r;
---
<Slide label="Now imagine" builds={5} class="f1">
  <div class="row grow f1-row">
    <div class="f1-room">
      <canvas class="f1-links" aria-hidden="true"></canvas>
      <Seats you={[3, 4]} label="The room: one person and their two neighbours, then everyone linked to the people around them, then links rewired across the room" />
    </div>
    <div class="col f1-side">
      <h2>Now imagine…</h2>
      <p class="f1-cap" data-b="1">What you just did: your two neighbours.</p>
      <p class="f1-cap" data-b="2">Now link everyone to the people <span class="accent">around them</span>: a grid.</p>
      <div class="f1-cap" data-b="3">
        <p>Rewire a share <b class="mono">p</b> of the links to anyone in the room: a <b>small-world network</b>.</p>
        <label class="f1-p"><b class="mono">p</b><input type="range" class="ctl" min="0" max="1" step="0.01" value="0.2" data-p aria-label="share of links rewired" /><output class="mono" data-pv>0.20</output></label>
      </div>
      <p class="f1-cap" data-b="4">A <b>network automaton</b>: the same rule for all, but anyone can be your neighbour.</p>
      <p class="f1-cap" data-b="5">But now some people have <b data-min>2</b> contacts and some have <b data-max>10</b>. “Exactly three neighbours” no longer makes sense.</p>
    </div>
  </div>
</Slide>

<Slide label="Count the share, not the number" builds={1} class="f2">
  <h2>Count the share, not the number</h2>
  <p class="lede"><b class="mono">ρ</b> = the share of your contacts with a hand up</p>
  <div class="f2-diagram">
    <p class="f2-name">The Game of Life as a Life-like network automaton, <Phi b={8} s={12} /></p>
    <svg viewBox="0 0 1500 420" aria-label="The rule diagram of the Game of Life: nine intervals of the share, born in one, survive in two">
      <text x="300" y="80" text-anchor="end" class="rl">hand down now:</text>
      <text x="300" y="118" text-anchor="end" class="rs">raise it here</text>
      <text x="300" y="220" text-anchor="end" class="rl">hand up now:</text>
      <text x="300" y="258" text-anchor="end" class="rs">keep it up here</text>
      {cells.map((c, i) => (
        <>
          <rect x={330 + i * cw + 3} y="30" width={cw - 6} height="120" class={c.b ? 'born' : 'off'} />
          <rect x={330 + i * cw + 3} y="170" width={cw - 6} height="120" class={c.s ? 'keep' : 'off'} />
        </>
      ))}
      <line x1="330" y1="316" x2={330 + r * cw} y2="316" class="ax" />
      {Array.from({ length: r + 1 }, (_, i) => <line x1={330 + i * cw} y1="306" x2={330 + i * cw} y2="326" class="ax" />)}
      <text x="330" y="370" text-anchor="middle" class="tk">0</text>
      <text x={330 + 4.5 * cw} y="370" text-anchor="middle" class="tk">½</text>
      <text x={330 + r * cw} y="370" text-anchor="middle" class="tk">1</text>
      <text x={330 + 4.5 * cw} y="412" text-anchor="middle" class="rs">share of contacts with a hand up, in nine intervals</text>
    </svg>
  </div>
  <p class="lede" data-b="1">One rule = at which shares you raise your hand (if it’s down) and keep it (if it’s up). With 9 intervals: 2<sup>18</sup> = 262,144 rules.</p>
</Slide>

<Slide label="Reading the rule: generosity" builds={3} class="f3">
  <div class="row grow f34-row">
    <div class="col f34-side">
      <h2>Reading the rule,&nbsp;1</h2>
      <p><b>Hamming weight</b>: the share of all situations in which the rule says <i>hand up</i>.</p>
      <p class="muted">If a share ρ of the room has hands up, and contacts were random, what share has hands up next round?</p>
      <p class="accent" data-b="2">Approximation: it ignores who is next to whom.</p>
      <p data-b="3">Crossings with the diagonal: where the room settles, in this approximation.</p>
    </div>
    <canvas class="plot" aria-label="Mean-field curve of the Game of Life for eight contacts, against the diagonal"></canvas>
  </div>
  <p class="cite">Game of Life, <Phi b={8} s={12} />, 8 contacts · drag across the plot to move ρ</p>
</Slide>

<Slide label="Reading the rule: sensitivity" builds={2} class="f4">
  <h2>Reading the rule, 2</h2>
  <p class="f4-lede">Two copies of this room, identical except one person. After one round, how many people differ?</p>
  <div class="row f4-row">
    <canvas class="plot" aria-label="Derrida curve of the Game of Life: differences next round against differences now"></canvas>
    <figure class="twin" data-b="1">
      <canvas aria-label="Two copies of a network running the same rule; red marks the people who differ"></canvas>
      <figcaption><span class="danger">red</span>: who differs · <span data-diff>1</span></figcaption>
    </figure>
  </div>
  <p class="f4-sum" data-b="2">The genotype predicts the phenotype, partly: Hamming weight ↔ final share (R ≈ 0.7), Boolean sensitivity ↔ spread of differences (R ≈ 0.55). Useful, not a substitute for simulation.</p>
  <p class="cite">Correlations over 528 rules on 900-node grids, thesis Ch. 5 · twin run: illustration on a rewired 30 × 30 grid</p>
</Slide>

<style>
  .f1-row { gap: calc(80 * var(--u)); align-items: stretch; }
  .f1-room { position: relative; flex: none; margin-top: calc(-30 * var(--u)); }
  .f1-room :global(.seats) { position: relative; height: calc(930 * var(--u)); width: auto; }
  .f1-links { position: absolute; inset: 0; width: 100%; height: 100%; }
  .f1-side { justify-content: center; gap: calc(32 * var(--u)); }
  .f1-cap { font-size: calc(40 * var(--u)); line-height: 1.25; }
  .f1-p { display: flex; align-items: center; gap: calc(20 * var(--u)); margin-top: calc(14 * var(--u)); font-size: calc(40 * var(--u)); }
  .f1-p input { width: calc(560 * var(--u)); }
  .f1-p output { min-width: 3em; }

  .f2-diagram { display: flex; flex-direction: column; gap: calc(10 * var(--u)); margin-top: calc(10 * var(--u)); }
  .f2-name { font-size: calc(34 * var(--u)); color: var(--muted); }
  .f2-diagram svg { width: calc(1500 * var(--u)); }
  :global(.f2) rect.born { fill: var(--accent); }
  :global(.f2) rect.keep { fill: var(--ink); }
  :global(.f2) rect.off { fill: var(--panel); stroke: var(--line); stroke-width: 2; }
  :global(.f2) .rl { font-family: var(--sans); font-size: 36px; font-weight: 600; fill: var(--ink); }
  :global(.f2) .rs { font-family: var(--sans); font-size: 30px; fill: var(--muted); }
  :global(.f2) .tk { font-family: var(--mono); font-size: 32px; fill: var(--muted); }
  :global(.f2) .ax { stroke: var(--muted); stroke-width: 3; }

  .f34-row { gap: calc(50 * var(--u)); align-items: center; }
  .f34-side { width: calc(640 * var(--u)); flex: none; gap: calc(30 * var(--u)); }
  :global(.f3) .plot { width: calc(1040 * var(--u)); height: calc(860 * var(--u)); flex: none; touch-action: none; cursor: ew-resize; }

  .f4-lede { max-width: calc(1600 * var(--u)); font-size: calc(42 * var(--u)); }
  .f4-row { gap: calc(60 * var(--u)); align-items: flex-start; }
  :global(.f4) .plot { width: calc(980 * var(--u)); height: calc(540 * var(--u)); flex: none; }
  .twin { margin: 0; display: flex; flex-direction: column; gap: calc(10 * var(--u)); }
  .twin canvas { width: calc(490 * var(--u)); height: calc(490 * var(--u)); }
  .twin figcaption { font-size: calc(32 * var(--u)); }
  .f4-sum { font-size: calc(34 * var(--u)); max-width: calc(1700 * var(--u)); margin-bottom: calc(24 * var(--u)); }
</style>

<script>
  import { slide, type How } from '../../scripts/defence/deck';
  import { stage, onSize, ticker, pointer } from '../../scripts/defence/stage';
  import { axes, curve, dot, line, label, px, py, type Plot } from '../../scripts/defence/plot';
  import { makeRng, lattice } from '../../scripts/net';
  import { room, wire, degrees, COLS } from '../../scripts/defence/room';
  import { type Rule, meanField, hammingWeight, step, randomState } from '../../scripts/llna';
  import { sensitivity, derridaCoeffs, derridaAt } from '../../scripts/genotype';

  const LIFE: Rule = { r: 9, B: 8, S: 12 }, K = 8;
  const f2 = (x: number) => (Math.abs(x - 0.5) < 1e-9 ? '½' : String(x));

  // ── F1: the room. Your two neighbours; then everyone linked to the people around them (the links grow out of each
  // person); then a share p of the links rewired across the room, live on a slider (the moving ends swing over). The
  // links are drawn on a canvas behind the seats, so a tween repaints the canvas and never the eighty people. ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.f1')) {
    const svg = s.querySelector<SVGSVGElement>('svg.seats')!, over = svg.querySelector('[data-over]')!, canvas = s.querySelector<HTMLCanvasElement>('canvas.f1-links')!;
    const seats = Array.from(svg.querySelectorAll<SVGUseElement>('use.seat'));
    const slider = s.querySelector<HTMLInputElement>('[data-p]')!, pv = s.querySelector<HTMLOutputElement>('[data-pv]')!;
    const minOut = s.querySelector('[data-min]')!, maxOut = s.querySelector('[data-max]')!;
    // Seed 12836: "you" keeps eight contacts at every p on the slider, as the next slides assume (npm test checks it).
    const you = 4 * COLS + 3, P0 = 0.2, R = room(12836), n = R.links.length, ns = 'http://www.w3.org/2000/svg', VIEW = 880;
    const cx = (i: number) => (i % COLS) * 110 + 48, cy = (i: number) => 96 + Math.floor(i / COLS) * 128 + 70;
    // each link's moving end: drawn at (x, y), on its way from (fx, fy) to the seat to[k]; `moving` lists the links in flight
    const x = new Float32Array(n), y = new Float32Array(n), fx = new Float32Array(n), fy = new Float32Array(n);
    let to = wire(R, 0), at = 0, t0 = 0, dur = 1, raf = 0, moving: number[] = [], shown = '';
    R.links.forEach((l, k) => { x[k] = cx(l.home); y[k] = cy(l.home); });
    const mine = (k: number) => R.links[k].stay === you || to[k] === you;
    function draw() {
      const st = stage(canvas); if (!st || at < 2) return;
      const { ctx, t } = st, k = st.w / VIEW;
      ctx.lineCap = 'round';
      for (const own of [false, true]) {
        ctx.beginPath();
        R.links.forEach((l, j) => { if (mine(j) === own) { ctx.moveTo(cx(l.stay) * k, cy(l.stay) * k); ctx.lineTo(x[j] * k, y[j] * k); } });
        ctx.strokeStyle = own ? t.accent : t.muted; ctx.globalAlpha = own ? 1 : 0.45; ctx.lineWidth = (own ? 2.5 : 2) * k;
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
    const frame = (now: number) => {
      const u = Math.min(1, (now - t0) / dur), e = u < 0.5 ? 2 * u * u : 1 - (-2 * u + 2) ** 2 / 2;
      for (const j of moving) { x[j] = fx[j] + (cx(to[j]) - fx[j]) * e; y[j] = fy[j] + (cy(to[j]) - fy[j]) * e; }
      draw();
      raf = u < 1 ? requestAnimationFrame(frame) : 0;
    };
    /** Move every link's end to its seat at p: over `ms`, or at once; `grow` starts each link at the person who keeps it. */
    function go(p: number, ms: number, grow = false) {
      to = wire(R, p);
      cancelAnimationFrame(raf); raf = 0; moving = [];
      R.links.forEach((l, j) => {
        if (grow) { x[j] = cx(l.stay); y[j] = cy(l.stay); }
        fx[j] = x[j]; fy[j] = y[j];
        if (x[j] !== cx(to[j]) || y[j] !== cy(to[j])) moving.push(j);
      });
      if (ms > 0 && moving.length) { t0 = performance.now(); dur = ms; raf = requestAnimationFrame(frame); }
      else { for (const j of moving) { x[j] = cx(to[j]); y[j] = cy(to[j]); } moving = []; }
      mark(); draw();
    }
    // who is highlighted: you, your contacts; from build 5 the fewest and the most contacts, circled
    function mark() {
      const near = new Set<number>();
      if (at === 1) { near.add(you - 1); near.add(you + 1); }
      if (at >= 2) R.links.forEach((l, j) => { if (l.stay === you) near.add(to[j]); else if (to[j] === you) near.add(l.stay); });
      seats.forEach((u, i) => { u.classList.toggle('you', at >= 1 && i === you); u.classList.toggle('near', near.has(i)); });
      if (at < 2) stage(canvas); // clears it
      const deg = degrees(R, to), lo = deg.indexOf(Math.min(...deg)), hi = deg.indexOf(Math.max(...deg));
      minOut.textContent = String(deg[lo]); maxOut.textContent = String(deg[hi]);
      const want = at >= 5 ? `${lo}:${deg[lo]} ${hi}:${deg[hi]}` : '';
      if (want === shown) return;
      shown = want; over.replaceChildren();
      if (want) for (const i of [lo, hi]) {
        const c = document.createElementNS(ns, 'circle'), tx = document.createElementNS(ns, 'text'), right = cx(i) > 440;
        c.setAttribute('cx', String(cx(i))); c.setAttribute('cy', String(cy(i) - 12)); c.setAttribute('r', '62'); c.setAttribute('fill', 'none'); c.setAttribute('stroke', 'var(--danger)'); c.setAttribute('stroke-width', '6');
        tx.setAttribute('x', String(cx(i) + (right ? -76 : 76))); tx.setAttribute('y', String(cy(i) + 4)); tx.setAttribute('text-anchor', right ? 'end' : 'start'); tx.setAttribute('font-size', '46'); tx.setAttribute('font-weight', '700'); tx.setAttribute('fill', 'var(--danger)'); tx.setAttribute('font-family', 'var(--sans)');
        tx.textContent = String(deg[i]); over.append(c, tx);
      }
    }
    const setP = (p: number) => { slider.value = String(p); pv.value = p.toFixed(2); };
    slider.addEventListener('input', () => { const p = +slider.value; pv.value = p.toFixed(2); go(p, 450); });
    slide(s, {
      set(b: number, how: How) {
        const was = at; at = b;
        if (b <= 1) { go(0, 0); return; }
        if (b === 2) { go(0, how === 'next' ? 1100 : was > 2 ? 450 : 0, how === 'next'); return; }
        if (b === 3 && how === 'next' && was === 2) { setP(P0); go(P0, 1400); return; }
        if (was < 2 || how === 'jump') go(+slider.value, 0); else mark();
      },
      enter() { setP(P0); },
    });
    setP(P0); mark();
    onSize(canvas, draw);
  }

  // ── F3: the mean-field curve, a draggable ρ, a cobweb and the crossings ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.f3')) {
    const c = s.querySelector<HTMLCanvasElement>('canvas')!;
    let at = 0, rho = 0.5;
    const f = (x: number) => meanField(LIFE, K, x), hw = hammingWeight(LIFE, K);
    const crossings: number[] = [0];
    for (let i = 1, prev = f(0.001) - 0.001; i < 1000; i++) { const x = i / 1000, d = f(x) - x; if (Math.sign(d) !== Math.sign(prev)) crossings.push(x - 0.0005); prev = d; }
    function paint() {
      const st = stage(c); if (!st) return;
      const { t } = st, p: Plot = { x: 150, y: 30, w: st.w - 190, h: st.h - 160, x0: 0, x1: 1, y0: 0, y1: 1 };
      const ticks: [number, string][] = [[0, '0'], [0.5, '½'], [1, '1']];
      axes(st, p, { xticks: ticks, yticks: ticks, xname: 'share with a hand up now, ρ', yname: 'share next round' });
      curve(st, p, (x) => x, t.muted, 2, [10, 10]);
      curve(st, p, f, t.accent, 6);
      // the reader's ρ
      line(st, px(p, rho), py(p, 0), px(p, rho), py(p, f(rho)), t.line, 3);
      dot(st, px(p, rho), py(p, f(rho)), 11, t.accent);
      label(st, `ρ = ${rho.toFixed(2)} → ${f(rho).toFixed(2)}`, px(p, rho) + 18, py(p, f(rho)) - 30, { size: 30, mono: true, bg: true });
      if (at >= 1) {
        dot(st, px(p, 0.5), py(p, hw), 14, t.danger);
        line(st, px(p, 0), py(p, hw), px(p, 0.5), py(p, hw), t.danger, 3, [6, 8]);
        label(st, `Hamming weight = ${hw.toFixed(2)}`, px(p, 0.5) + 24, py(p, hw) + 34, { color: t.danger, size: 34, weight: 600, bg: true });
      }
      if (at >= 2) {
        let x = 0.5;
        st.ctx.strokeStyle = t.danger; st.ctx.lineWidth = 3; st.ctx.beginPath(); st.ctx.moveTo(px(p, x), py(p, 0));
        for (let k = 0; k < 3; k++) { const y = f(x); st.ctx.lineTo(px(p, x), py(p, y)); st.ctx.lineTo(px(p, y), py(p, y)); x = y; }
        st.ctx.stroke();
      }
      if (at >= 3) for (const x of crossings) { dot(st, px(p, x), py(p, x), 12, t.bg, t.ink); label(st, x.toFixed(2), px(p, x) + 4, py(p, x) - 30, { size: 28, mono: true, bg: true }); }
    }
    let drag = false;
    const move = (e: PointerEvent) => { const st = stage(c); if (!st) return; const q = pointer(c, e); rho = Math.min(1, Math.max(0, (q.x - 150) / (st.w - 190))); paint(); };
    c.addEventListener('pointerdown', (e) => { drag = true; c.setPointerCapture(e.pointerId); move(e); });
    c.addEventListener('pointermove', (e) => { if (drag) move(e); });
    c.addEventListener('pointerup', () => { drag = false; });
    slide(s, { set(b) { at = b; paint(); }, enter() { rho = 0.5; } });
    onSize(c, paint);
  }

  // ── F4: the Derrida curve with its slope at the origin, and a twin run ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.f4')) {
    const [plot, grid] = Array.from(s.querySelectorAll<HTMLCanvasElement>('canvas'));
    const bs = sensitivity(LIFE, K).BS, dc = derridaCoeffs(LIFE, K, 0.5), top = 0.6;
    function paintPlot() {
      const st = stage(plot); if (!st) return;
      const { t } = st, p: Plot = { x: 150, y: 20, w: st.w - 180, h: st.h - 150, x0: 0, x1: top, y0: 0, y1: top };
      axes(st, p, { xticks: [[0, '0'], [0.2, '0.2'], [0.4, '0.4'], [0.6, '0.6']], yticks: [[0, '0'], [0.2, '0.2'], [0.4, '0.4'], [0.6, '0.6']], xname: 'share that differs now', yname: 'differs next round' });
      curve(st, p, (x) => x, t.muted, 2, [10, 10]);
      curve(st, p, (x) => derridaAt(dc, x), t.accent, 6);
      const x1 = top / bs; // the tangent at the origin, up to the top of the box
      line(st, px(p, 0), py(p, 0), px(p, x1), py(p, top), t.danger, 4);
      label(st, `slope at 0: ${bs.toFixed(2)}`, px(p, x1) + 16, py(p, top) + 22, { color: t.danger, size: 32, weight: 600, bg: true });
      label(st, '= Boolean sensitivity', px(p, x1) + 16, py(p, top) + 62, { color: t.danger, size: 30, bg: true });
      label(st, 'above 1: differences grow', px(p, 0.3), py(p, 0.1), { color: t.muted, size: 26 });
      label(st, 'below 1: they die out', px(p, 0.3), py(p, 0.05), { color: t.muted, size: 26 });
    }
    // twin run: Life as a network automaton on a lightly rewired 30 × 30 grid, one person flipped in copy b
    const side = 30, N = side * side, net = lattice(side, 8, 0.05, makeRng(55)), flip = 15 * side + 15;
    let a = new Uint8Array(N), b = new Uint8Array(N), a2 = new Uint8Array(N), b2 = new Uint8Array(N), ticks = 0;
    const out = s.querySelector<HTMLElement>('[data-diff]')!;
    const reset = () => { a = randomState(N, 0.5, makeRng(5)); b = a.slice(); b[flip] ^= 1; ticks = 0; };
    const diff = () => { let d = 0; for (let i = 0; i < N; i++) d += a[i] ^ b[i]; return d; };
    function paintGrid() {
      const st = stage(grid); if (!st) return;
      const { ctx, t } = st, cell = st.w / side;
      ctx.fillStyle = t.panel; ctx.fillRect(0, 0, st.w, st.h);
      for (let i = 0; i < N; i++) {
        const x = (i % side) * cell, y = Math.floor(i / side) * cell;
        if (a[i] !== b[i]) { ctx.fillStyle = t.danger; ctx.fillRect(x, y, cell - 1, cell - 1); }
        else if (a[i]) { ctx.fillStyle = t.ink; ctx.fillRect(x, y, cell - 1, cell - 1); }
      }
      out.textContent = `${diff()} of ${N} after ${ticks} round${ticks === 1 ? '' : 's'}`;
    }
    const run = ticker(s, 4, () => { step(a, net, LIFE, a2); step(b, net, LIFE, b2); [a, a2] = [a2, a]; [b, b2] = [b2, b]; ticks++; if (ticks >= 150) return true; }, paintGrid);
    reset();
    slide(s, {
      set(k: number, how: How) { if (k >= 1 && !run.playing && (how === 'next' || ticks === 0)) { if (how === 'next') reset(); run.play(true); } if (k === 0) { run.play(false); reset(); } paintGrid(); },
      enter() { reset(); },
      leave() { run.play(false); },
    });
    onSize(plot, paintPlot); onSize(grid, paintGrid);
  }
</script>

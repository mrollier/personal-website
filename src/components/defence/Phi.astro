---
// A rule name as the thesis writes it: φ with the resolution above and β,σ below, stacked.
type Props = { r?: number; b: number; s: number };
const { r = 9, b, s } = Astro.props;
---
<span class="phi" aria-label={`phi ${r}, ${b} ${s}`}>φ<span class="ss"><span>{r}</span><span>{b},{s}</span></span></span>

<style>
  .phi { white-space: nowrap; font-family: var(--mono); }
  .ss { display: inline-flex; flex-direction: column; font-size: 0.55em; line-height: 1.05; vertical-align: 0.32em; margin-left: 0.05em; }
</style>

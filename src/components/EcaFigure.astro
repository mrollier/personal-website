---
// A static space-time diagram of one rule, drawn at build time as inline SVG (one unit per cell),
// themed with the site's CSS variables like the mountain map.
import { evolve, seedRow, type Boundary, type Init } from '../scripts/eca';
type Props = { rule: number; width: number; gens: number; boundary?: Boundary; init?: Init; label?: string };
const { rule, width, gens, boundary = 'periodic', init = 'seed', label } = Astro.props;
const rows = evolve(seedRow(width, init), rule, boundary, gens);
const alt = label ?? `Rule ${rule} on ${width} cells with ${boundary} boundary, ${gens} generations from a ${init === 'seed' ? 'single seed' : 'random row'}`;
---
<figure class="fig">
  <svg viewBox={`0 0 ${width} ${rows.length}`} shape-rendering="crispEdges" role="img" aria-label={alt}>
    <rect width={width} height={rows.length} fill="var(--panel)" />
    {rows.map((row, y) => Array.from(row).map((v, x) => v ? <rect x={x + 0.05} y={y + 0.05} width="0.9" height="0.9" fill="var(--ink)" /> : null))}
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .fig { margin: 0 0 1rem; }
  svg { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  figcaption { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-top: 0.4rem; }
</style>

---
// What the deck shows around the slide while presenting: the counter, the rehearsal clock, the way out, the black
// screen of the clicker's blank button, and the pictograms the slides draw people with.
type Props = { exit?: boolean };
const { exit = true } = Astro.props;
---
<div class="hud">
  <output data-clock hidden></output>
  <output data-counter></output>
  {exit && <button type="button" data-exit aria-label="leave the presentation" title="leave (q)">&times;</button>}
</div>
<div class="blank" data-blank hidden></div>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <!-- a person with an arm raised (just the arm, no hand), and the same person with both arms down; 100 × 130, the
         body in the same place in both so a seat can switch between them. Every person in the deck is one of these. -->
    <symbol id="hand-up" viewBox="0 0 100 130">
      <circle cx="42" cy="40" r="17" />
      <path d="M8 128 C8 96 20 74 42 74 C64 74 76 96 76 128 Z" />
      <path d="M65 93 C80 85 84.5 70 84.5 27" stroke-width="12.5" stroke-linecap="round" fill="none" />
    </symbol>
    <symbol id="hand-down" viewBox="0 0 100 130">
      <circle cx="42" cy="40" r="17" stroke-width="3" />
      <path d="M8 128 C8 96 20 74 42 74 C64 74 76 96 76 128 Z" stroke-width="3" />
    </symbol>
  </defs>
</svg>

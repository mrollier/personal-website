---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import MountainMap from '../components/MountainMap.astro';
import Strip from '../components/Strip.astro';
import alps from '../assets/photos/alps-matterhorn.jpg';
import dolomites from '../assets/photos/dolomites.jpg';
import cliff from '../assets/photos/cliff.jpg';
const photos = [
  [alps, 'On a snowy summit ridge with the Matterhorn in the distance', 'Matterhorn in the distance'],
  [dolomites, 'Standing in a narrow limestone gully in the Dolomites, climbing helmet on', 'A gully in the Dolomites'],
  [cliff, 'On a volcanic ridge above the Atlantic', 'Volcanic ridge above the Atlantic'],
] as const;
const summits = (await getCollection('mountains')).sort((a, b) => b.data.elevation - a.data.elevation);
const anyDate = summits.some((s) => s.data.date);
const fmt = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
---
<Base title="Mountains" description="Summits, with dates and a map.">
  <h1>Mountains</h1>
  <Strip kind="photos" label="Photos" count={photos.length}>
    {photos.map(([src, alt, caption], i) => (
      <li>
        <Image src={src} alt={alt} widths={[700, 1400]} sizes="(max-width: 700px) 100vw, 650px" loading={i ? 'lazy' : 'eager'} />
        <span class="cap">{caption}</span>
      </li>
    ))}
  </Strip>
  <MountainMap points={summits.map((s) => s.data)} />
  {summits.length ? (
    <div class="scroll">
      <table>
        <thead><tr><th class="num">#</th><th>Summit</th><th class="num">m</th>{anyDate && <th>Date</th>}<th>Where</th><th>Note</th></tr></thead>
        <tbody>
          {summits.map((s, i) => (
            <tr>
              <td class="num">{i + 1}</td>
              <td>{s.data.name}</td>
              <td class="num">{s.data.elevation}</td>
              {anyDate && <td class="num">{fmt(s.data.date)}</td>}
              <td>{s.data.country}</td>
              <td>{s.data.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="meta">Summit list on its way.</p>
  )}
</Base>

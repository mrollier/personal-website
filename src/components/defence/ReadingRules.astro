---
// F3–F4: the two metrics that read a rule before it runs: its generosity, the Hamming weight (with the mean-field
// curve), and its volatility, the Boolean sensitivity (with the Derrida curve and a twin run).
import Slide from './Slide.astro';
import SimButton from './SimButton.astro';
---
<Slide label="Reading the rule: generosity" builds={3} class="f3" ch={5}>
  <div class="row grow f34-row">
    <div class="col f34-side">
      <h2>Reading the rule, 1: generosity</h2>
      <p>How often the rule says <b>on</b>: its Hamming weight.</p>
      <p>If a share of the nodes is on now, what share is on next round?</p>
      <p data-b="3">Where the curve crosses the diagonal, the network settles.</p>
    </div>
    <canvas class="plot" aria-label="Mean-field curve of the Game of Life for eight neighbours, against the diagonal"></canvas>
  </div>
  <p class="cite">Game of Life, eight neighbours each</p>
  <p slot="say">Can we say something about a rule before we run it? The first number is its generosity, or Hamming weight: in what share of all situations the rule says on. The curve answers a simple question: if a certain share of the nodes is on, and neighbours were picked at random, what share will be on next round? At half on, the height of the curve is the Hamming weight.</p>
  <p slot="say">Following the curve step by step is an approximation, because it ignores who is next to whom: real networks build up correlations immediately, which is why we still simulate. Where the curve crosses the diagonal, the share stops changing: that is where the network settles, in this approximation. On this page you can drag across the plot to pick a starting share.</p>
</Slide>

<Slide label="Reading the rule: sensitivity" builds={3} class="f4" ch={5}>
  <h2>Reading the rule, 2: volatility</h2>
  <p class="f4-lede">Two copies of a network, one node different. How many differ a round later?</p>
  <div class="row f4-row">
    <canvas class="plot" aria-label="Derrida curve of the Game of Life: differences next round against differences now"></canvas>
    <figure class="twin" data-b="1">
      <div class="twin-box">
        <canvas aria-label="Two copies of a network running the same rule; red marks the nodes that differ"></canvas>
        <SimButton class="f4-btn" />
      </div>
      <figcaption><span class="danger">red</span>: differs · <span data-diff>1</span></figcaption>
    </figure>
  </div>
  <p class="result" data-b="3"><b>Our result</b> Two numbers read from the rule predict the behaviour, partly: how many nodes end up on (correlation 0.7), and how far differences spread (0.55).</p>
  <p class="cite">Correlations: 528 rules on grids of 900 nodes · twin run: illustration</p>
  <p slot="say">The second number asks how volatile a rule is. Take two copies of the same network, identical except for one node, and run one round: how many nodes now differ? The slope of this curve at the start is the Boolean sensitivity: how many nodes one difference reaches in one round, on average. Above one, differences grow; below one, they die out, again in this approximation.</p>
  <p slot="say">Remember a hand that went wrong in the game: this is the same thing on a network, with the differences in red. For the simplest rules, like rule 90 on a network, Chapter 4 computes exactly how fast such differences grow; that result stays out of tonight’s talk.</p>
  <p slot="say">Our result: the two numbers predict the behaviour, partly. The generosity predicts how many nodes end up on (a correlation of about 0.7 over 528 rules), the volatility how far differences spread (about 0.55). Useful, but no substitute for simulation.</p>
</Slide>

<style>
  .f34-row { gap: calc(50 * var(--u)); align-items: center; }
  .f34-side { width: calc(640 * var(--u)); flex: none; gap: calc(30 * var(--u)); }
  :global(.f3) .plot { width: calc(1040 * var(--u)); height: calc(860 * var(--u)); flex: none; touch-action: none; cursor: ew-resize; }

  .f4-lede { max-width: calc(1600 * var(--u)); font-size: calc(42 * var(--u)); }
  .f4-row { gap: calc(60 * var(--u)); align-items: flex-start; }
  :global(.f4) .plot { width: calc(980 * var(--u)); height: calc(500 * var(--u)); flex: none; }
  .twin { margin: 0; display: flex; flex-direction: column; gap: calc(10 * var(--u)); }
  .twin-box { position: relative; }
  .twin canvas { width: calc(420 * var(--u)); height: calc(420 * var(--u)); }
  .twin-box :global(.f4-btn) { right: calc(-96 * var(--u)); bottom: 0; }
  .twin figcaption { font-size: calc(32 * var(--u)); }
  :global(.f4) .result { margin-top: auto; }
</style>

<script>
  import { slide, sim } from '../../scripts/defence/deck';
  import { stage, onSize, ticker, pointer } from '../../scripts/defence/stage';
  import { axes, curve, dot, line, label, px, py, type Plot } from '../../scripts/defence/plot';
  import { makeRng, lattice } from '../../scripts/net';
  import { type Rule, meanField, hammingWeight, step, randomState } from '../../scripts/llna';
  import { sensitivity, derridaCoeffs, derridaAt } from '../../scripts/genotype';

  const LIFE: Rule = { r: 9, B: 8, S: 12 }, K = 8;

  // ── F3: the mean-field curve, a draggable ρ, a cobweb and the crossings ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.f3')) {
    const c = s.querySelector<HTMLCanvasElement>('canvas')!;
    let at = 0, rho = 0.5;
    const f = (x: number) => meanField(LIFE, K, x), hw = hammingWeight(LIFE, K);
    const crossings: number[] = [0];
    for (let i = 1, prev = f(0.001) - 0.001; i < 1000; i++) { const x = i / 1000, d = f(x) - x; if (Math.sign(d) !== Math.sign(prev)) crossings.push(x - 0.0005); prev = d; }
    function paint() {
      const st = stage(c); if (!st) return;
      const { t } = st, p: Plot = { x: 150, y: 30, w: st.w - 190, h: st.h - 160, x0: 0, x1: 1, y0: 0, y1: 1 };
      const ticks: [number, string][] = [[0, '0'], [0.5, '½'], [1, '1']];
      axes(st, p, { xticks: ticks, yticks: ticks, xname: 'share on now', yname: 'share on next round' });
      curve(st, p, (x) => x, t.muted, 2, [10, 10]);
      curve(st, p, f, t.accent, 6);
      // the reader's starting share
      line(st, px(p, rho), py(p, 0), px(p, rho), py(p, f(rho)), t.line, 3);
      dot(st, px(p, rho), py(p, f(rho)), 11, t.accent);
      label(st, `${rho.toFixed(2)} → ${f(rho).toFixed(2)}`, px(p, rho) + 18, py(p, f(rho)) - 30, { size: 30, bg: true });
      if (at >= 1) {
        dot(st, px(p, 0.5), py(p, hw), 14, t.danger);
        line(st, px(p, 0), py(p, hw), px(p, 0.5), py(p, hw), t.danger, 3, [6, 8]);
        label(st, `Hamming weight ${hw.toFixed(2)}`, px(p, 0.5) + 24, py(p, hw) + 34, { color: t.danger, size: 34, weight: 600, bg: true });
      }
      if (at >= 2) {
        let x = 0.5;
        st.ctx.strokeStyle = t.danger; st.ctx.lineWidth = 3; st.ctx.beginPath(); st.ctx.moveTo(px(p, x), py(p, 0));
        for (let k = 0; k < 3; k++) { const y = f(x); st.ctx.lineTo(px(p, x), py(p, y)); st.ctx.lineTo(px(p, y), py(p, y)); x = y; }
        st.ctx.stroke();
      }
      if (at >= 3) for (const x of crossings) { dot(st, px(p, x), py(p, x), 12, t.bg, t.ink); label(st, x.toFixed(2), px(p, x) + 4, py(p, x) - 30, { size: 28, bg: true }); }
    }
    let drag = false;
    const move = (e: PointerEvent) => { const st = stage(c); if (!st) return; const q = pointer(c, e); rho = Math.min(1, Math.max(0, (q.x - 150) / (st.w - 190))); paint(); };
    c.addEventListener('pointerdown', (e) => { drag = true; c.setPointerCapture(e.pointerId); move(e); });
    c.addEventListener('pointermove', (e) => { if (drag) move(e); });
    c.addEventListener('pointerup', () => { drag = false; });
    slide(s, { set(b) { at = b; paint(); }, enter() { rho = 0.5; } });
    onSize(c, paint);
  }

  // ── F4: the Derrida curve with its slope at the origin, and a twin run ──
  for (const s of document.querySelectorAll<HTMLElement>('.slide.f4')) {
    const [plot, grid] = Array.from(s.querySelectorAll<HTMLCanvasElement>('canvas'));
    const bs = sensitivity(LIFE, K).BS, dc = derridaCoeffs(LIFE, K, 0.5), top = 0.6;
    function paintPlot() {
      const st = stage(plot); if (!st) return;
      const { t } = st, p: Plot = { x: 150, y: 20, w: st.w - 180, h: st.h - 150, x0: 0, x1: top, y0: 0, y1: top };
      axes(st, p, { xticks: [[0, '0'], [0.2, '0.2'], [0.4, '0.4'], [0.6, '0.6']], yticks: [[0, '0'], [0.2, '0.2'], [0.4, '0.4'], [0.6, '0.6']], xname: 'share that differs now', yname: 'differs next round' });
      curve(st, p, (x) => x, t.muted, 2, [10, 10]);
      curve(st, p, (x) => derridaAt(dc, x), t.accent, 6);
      const x1 = top / bs; // the tangent at the origin, up to the top of the box
      line(st, px(p, 0), py(p, 0), px(p, x1), py(p, top), t.danger, 4);
      label(st, `slope at the start: ${bs.toFixed(2)}`, px(p, x1) + 16, py(p, top) + 22, { color: t.danger, size: 32, weight: 600, bg: true });
      label(st, '= the volatility', px(p, x1) + 16, py(p, top) + 62, { color: t.danger, size: 30, bg: true });
    }
    // twin run: Life as a network automaton on a lightly rewired 30 × 30 grid, one node flipped in copy b; shown at
    // build 1, started at 2
    const side = 30, N = side * side, net = lattice(side, 8, 0.05, makeRng(55)), flip = 15 * side + 15;
    let a = new Uint8Array(N), b = new Uint8Array(N), a2 = new Uint8Array(N), b2 = new Uint8Array(N), ticks = 0, seed = 5;
    const out = s.querySelector<HTMLElement>('[data-diff]')!;
    const reset = () => { a = randomState(N, 0.5, makeRng(seed)); b = a.slice(); b[flip] ^= 1; ticks = 0; };
    const diff = () => { let d = 0; for (let i = 0; i < N; i++) d += a[i] ^ b[i]; return d; };
    function paintGrid() {
      const st = stage(grid); if (!st) return;
      const { ctx, t } = st, cell = st.w / side;
      ctx.fillStyle = t.panel; ctx.fillRect(0, 0, st.w, st.h);
      for (let i = 0; i < N; i++) {
        const x = (i % side) * cell, y = Math.floor(i / side) * cell;
        if (a[i] !== b[i]) { ctx.fillStyle = t.danger; ctx.fillRect(x, y, cell, cell); }
        else if (a[i]) { ctx.fillStyle = t.ink; ctx.fillRect(x, y, cell, cell); }
      }
      out.textContent = `${diff()} of ${N} after ${ticks} round${ticks === 1 ? '' : 's'}`;
    }
    const run = ticker(s, 4, () => { step(a, net, LIFE, a2); step(b, net, LIFE, b2); [a, a2] = [a2, a]; [b, b2] = [b2, b]; ticks++; if (ticks >= 150) return true; }, paintGrid);
    reset();
    sim(s.querySelector<HTMLButtonElement>('[data-simbtn]')!, 2, {
      reset() { run.play(false); reset(); paintGrid(); },
      play() { run.play(true); },
      reroll() { seed = (Math.random() * 4294967296) >>> 0; },
    });
    slide(s, { enter() { seed = 5; reset(); }, leave() { run.play(false); } });
    onSize(plot, paintPlot); onSize(grid, paintGrid);
  }
</script>
